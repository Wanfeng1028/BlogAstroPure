---
import config from 'virtual:config'

import { Icon } from '../user'
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-6 flex items-center justify-between rounded-2xl px-4 py-2 backdrop-blur-md sm:px-6'
>
  <a
    class='flex items-center gap-3 transition-colors hover:opacity-80'
    href='/'
    aria-label='Brand'
  >
    <span class='brand-avatar-wrap'>
      <img
        src={config.logo?.src ?? '/src/assets/touxiang.png'}
        alt={config.title}
        class='size-8 object-cover'
        width='32'
        height='32'
      />
      <span class='brand-avatar-glow' aria-hidden='true' />
      <span class='brand-avatar-ring' aria-hidden='true' />
    </span>
    <span class='text-lg font-medium tracking-tight text-foreground'>{config.title}</span>
  </a>

  <div class='flex items-center gap-1'>
    {/* Menu links */}
    <nav
      id='headerExpandContent'
      class='flex items-center'
      aria-label='Main navigation'
    >
      <div class='flex items-center gap-0.5'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='nav-link relative rounded-full px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground hover:bg-muted/80'
              aria-label={item.title}
              data-astro-prefetch
            >
              {item.title}
            </a>
          ))
        }
      </div>
    </nav>

    {/* Action buttons */}
    <div class='ml-1 flex items-center gap-0.5'>
      <a
        class='rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted/80 hover:text-foreground'
        href='/search'
        title='Search'
        aria-label='Search'
      >
        <span class='sr-only'>Search</span>
        <Icon name='search' class='size-[18px]' />
      </a>
      <button
        id='toggleDarkMode'
        class='rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted/80 hover:text-foreground'
        aria-label='Toggle dark mode'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-[18px]' name='computer' />
        <Icon class='light hidden size-[18px]' name='sun' />
        <Icon class='dark hidden size-[18px]' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted/80 hover:text-foreground sm:hidden'
        aria-label='Menu'
      >
        <span class='sr-only'>Menu</span>
        <Icon class='size-[18px]' name='menu' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      // Header
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // Dark Mode
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        // Old way: dispatch event
        // const toggleDarkModeEvent = new CustomEvent('theme-change', {
        //   detail: { theme: localStorage.getItem('theme') === 'light' ? 'dark' : 'light' }
        // })
        // document.dispatchEvent(toggleDarkModeEvent)
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `Set theme to ${newTheme}` })
      })

      // Menu
      this.querySelector('#toggleMenu')?.addEventListener('click', () => {
        this.classList.toggle('expanded')
      })
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  @keyframes google-ring-spin {
    to { transform: rotate(360deg); }
  }

  @property --header-ring-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes header-ring-spin {
    to { --header-ring-angle: 360deg; }
  }

  header-component {
    --header-ring-angle: 0deg;
    border: 2px solid transparent;
    background:
      linear-gradient(hsl(var(--background) / 0.92), hsl(var(--background) / 0.92)) padding-box,
      conic-gradient(
          from var(--header-ring-angle),
          #4285f4,
          #34a853,
          #fbbc05,
          #ea4335,
          #4285f4
        )
        border-box;
    animation: header-ring-spin 1.5s linear infinite;
    transition: box-shadow 0.2s;

    &.not-top {
      box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.12);
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header-component {
      animation: none;
    }
  }

  /* Brand avatar ring */
  .brand-avatar-wrap {
    position: relative;
    display: inline-flex;
  }
  .brand-avatar-wrap img {
    position: relative;
    z-index: 1;
    border-radius: 9999px;
  }
  .brand-avatar-ring {
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    background: conic-gradient(from 0deg, #4285f4, #34a853, #fbbc05, #ea4335, #4285f4);
    animation: google-ring-spin 3s linear infinite;
    z-index: 0;
  }
  .brand-avatar-glow {
    position: absolute;
    inset: -4px;
    border-radius: 9999px;
    background: conic-gradient(from 0deg, #4285f4, #34a853, #fbbc05, #ea4335, #4285f4);
    filter: blur(4px);
    opacity: 0.5;
    animation: google-ring-spin 3s linear infinite;
    z-index: -1;
  }

  /* Active nav link underline */
  .nav-link {
    position: relative;
    &::after {
      content: '';
      position: absolute;
      bottom: 2px;
      left: 50%;
      transform: translateX(-50%) scaleX(0);
      width: 60%;
      height: 2px;
      border-radius: 999px;
      background-color: hsl(var(--primary) / var(--un-bg-opacity, 1));
      transition: transform 0.2s ease;
    }
    &:hover::after,
    &.active::after {
      transform: translateX(-50%) scaleX(1);
    }
  }

  /* Dark mode */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system { display: none; }
      & .dark { display: block; }
      & .light { display: none; }
    }
    &[data-theme='light'] {
      & .system { display: none; }
      & .light { display: block; }
      & .dark { display: none; }
    }
  }
</style>
