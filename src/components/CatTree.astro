---
interface CatNode {
  name: string
  path: string
  own: number
  total: number
  children: CatNode[]
}

interface Props {
  nodes: CatNode[]
}

const { nodes } = Astro.props
---

<ul class='flex flex-col gap-3'>
  {nodes.map((node) => (
    <li>
      <a
        href={`/categories/${node.path}`}
        data-astro-prefetch
        class='group flex items-center gap-x-2 rounded-xl border border-border bg-card px-4 py-2 no-underline transition-all hover:border-primary hover:shadow-sm'
      >
        <span class='font-medium text-foreground transition-colors group-hover:text-primary'>
          {node.name}
        </span>
        <span class='rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground'>
          {node.total}
        </span>
      </a>
      {node.children.length > 0 && (
        <div class='mt-3 border-l border-border pl-5'>
          <Astro.self nodes={node.children} />
        </div>
      )}
    </li>
  ))}
</ul>
