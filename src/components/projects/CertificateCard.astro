---
import { cn } from 'astro-pure/utils'

// ===== Props 类型定义 =====
type TagColor = 'purple' | 'aqua' | 'green' | 'orange' | 'blue' | 'pink' | 'red' | 'yellow'

type Props = {
  href: string
  /** 颁发机构（类似 GitHub namespace） */
  issuer: string
  /** 证书名称 */
  title: string
  /** 证书描述 / 备注 */
  description: string
  /** 颁发年份 */
  year: number
  /** 有效期（可选，如 "永久"、"2026-2029"）；不显示传空 */
  validity?: string
  /** 证书类型 pill（如 "Professional"、"初级"、"Associate"） */
  certType?: { text: string; dotColor?: string }
  /** 资质领域 pill（如 "前端开发"、"云计算"），作为主语言位置 */
  category: { text: string; dotColor?: string }
  /** 主色调（hover 强调、默认圆点色） */
  accent?: string
  /** 装饰 emoji / 左侧头像内容 */
  deco?: string
  /** 右侧功能图标（默认 🔗 链接） */
  actionIcon?: string
  /** 用于分类筛选的 data-type 值 */
  dataType?: string
  class?: string
}

const {
  href,
  issuer,
  title,
  description,
  year,
  validity,
  certType,
  category,
  accent = '#d4a72c',
  deco = '🏅',
  actionIcon = '🔗',
  dataType,
  class: className
} = Astro.props
---

<a
  href={href}
  target='_blank'
  rel='noopener'
  class={cn('gh-card gh-card--cert group', className)}
  data-type={dataType}
  style={`--gh-accent: ${accent}; --gh-lang-dot: ${category.dotColor ?? accent};`}
>
  {/* ===== 顶部：机构 / 证书名 + 右侧操作图标 ===== */}
  <div class='gh-card__head'>
    <div class='gh-card__head-left'>
      <div class='gh-card__avatar' aria-hidden='true'>
        <span>{deco}</span>
      </div>
      <div class='gh-card__names'>
        <span class='gh-card__namespace'>{issuer}<span class='gh-card__slash'> / </span></span>
        <span class='gh-card__title'>{title}</span>
      </div>
    </div>
    <div class='gh-card__action' aria-hidden='true'>
      <span>{actionIcon}</span>
    </div>
  </div>

  {/* ===== 中部：描述 ===== */}
  <p class='gh-card__desc'>{description}</p>

  {/* ===== 底部：元信息 ===== */}
  <div class='gh-card__foot'>
    <div class='gh-card__stats'>
      {/* 颁发年份（日历图标） */}
      <span class='gh-card__stat'>
        <svg class='gh-card__icon gh-card__icon-cal' viewBox='0 0 16 16' aria-hidden='true'><path fill='currentColor' d='M4 .75a.75.75 0 0 1 .75.75v.25h6.5V1.5a.75.75 0 0 1 1.5 0v.25h.5A1.75 1.75 0 0 1 15 3.5v8.75A1.75 1.75 0 0 1 13.25 14h-10.5A1.75 1.75 0 0 1 1 12.25V3.5A1.75 1.75 0 0 1 2.75 1.75h.5V1.5a.75.75 0 0 1 .75-.75Zm0 1.75h-.5a.25.25 0 0 0-.25.25v.25h11V3.5a.25.25 0 0 0-.25-.25h-10Zm11 1.75H2.5v8c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-8Z'/></svg>
        <span>{year}</span>
      </span>
      {/* 有效期（可选，沙漏图标） */}
      {validity && validity !== '' && (
        <span class='gh-card__stat'>
          <svg class='gh-card__icon gh-card__icon-hourglass' viewBox='0 0 16 16' aria-hidden='true'><path fill='currentColor' d='M2 1.75C2 .784 2.784 0 3.75 0h8.5c.966 0 1.75.784 1.75 1.75v1.5a.75.75 0 0 1-1.5 0V2H3v1.25a.75.75 0 0 1-1.5 0v-1.5ZM6.22 8 2.5 4.1V3h11v1.1L9.78 8a.25.25 0 0 0 0 .351L13.5 11.96V13H2.5v-1.04l3.72-3.609a.25.25 0 0 0 0-.351ZM2 13V12.04l3.778-3.662a1.75 1.75 0 0 0 0-2.473L2 2.28V1.75A.25.25 0 0 1 2.25 1.5h11.5a.25.25 0 0 1 .25.25v.534l-3.778 3.665a1.75 1.75 0 0 0 0 2.472L14 12.035V13h-.25a.25.25 0 0 0-.25.25v1a.75.75 0 0 1-1.5 0v-1a.25.25 0 0 0-.25-.25H4.25a.25.25 0 0 0-.25.25v1a.75.75 0 0 1-1.5 0v-1A.25.25 0 0 0 2.25 13H2Z'/></svg>
          <span>{validity}</span>
        </span>
      )}
    </div>

    <div class='gh-card__pills'>
      {/* 证书类型（可选） */}
      {certType && certType.text !== '' && (
        <span class='gh-card__pill gh-card__pill-license'>
          <svg class='gh-card__icon gh-card__icon-badge' viewBox='0 0 16 16' aria-hidden='true'><path fill='currentColor' d='M7.467.133a1.748 1.748 0 0 1 2.066 0l4.757 2.91a1.764 1.764 0 0 1 .674 2.018l-1.2 4.322c-.147.53-.46.99-.892 1.288L8.233 15.88a1.717 1.717 0 0 1-2.078.001l-3.79-4.869a2.225 2.225 0 0 1-.84-1.223L.295 5.06a1.764 1.764 0 0 1 .674-2.018l4.758-2.909ZM8.67 1.155a.25.25 0 0 0-.3 0L3.612 4.065a.264.264 0 0 0-.1.302l1.201 4.323c.057.204.196.381.38.497L8.8 14.05a.217.217 0 0 0 .263 0l3.707-4.763a.727.727 0 0 0 .379-.497l1.2-4.322a.264.264 0 0 0-.101-.302L8.67 1.155ZM6.57 8.05a1.5 1.5 0 1 1 2.86.053 2 2 0 0 1 .828 1.15l.007.046.232.855a.5.5 0 0 1-.97.237l-.145-.594a1 1 0 0 0-.414-.579l-.125-.08a1 1 0 0 0-1.052 0l-.126.08a1 1 0 0 0-.414.579l-.144.594a.5.5 0 0 1-.97-.237l.232-.856a2 2 0 0 1 .828-1.15Z'/></svg>
          <span>{certType.text}</span>
        </span>
      )}
      {/* 资质领域（主语言 pill 位置） */}
      <span class='gh-card__pill gh-card__pill-lang'>
        <span class='gh-card__lang-dot' aria-hidden='true' style={certType?.dotColor ? `--gh-lang-dot: ${certType.dotColor}` : undefined}></span>
        <span>{category.text}</span>
      </span>
    </div>
  </div>
</a>

<style>
  /* ===== GitHub 风格仓库卡片 ===== */
  .gh-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 1.1rem;
    width: 100%;
    min-height: 148px;
    background: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .gh-card:hover {
    border-color: #afb8c1;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 6px 18px -8px rgba(0, 0, 0, 0.15);
  }
  .dark .gh-card {
    background: #0d1117;
    border-color: #30363d;
  }
  .dark .gh-card:hover {
    border-color: #484f58;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 22px -10px rgba(0, 0, 0, 0.6);
  }

  /* ===== 顶部 ===== */
  .gh-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .gh-card__head-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    flex: 1;
  }
  .gh-card__avatar {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: linear-gradient(135deg, #f6f8fa, #eaeef2);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid #d0d7de;
  }
  .gh-card__avatar > span {
    font-size: 14px;
    line-height: 1;
  }
  .dark .gh-card__avatar {
    background: linear-gradient(135deg, #21262d, #161b22);
    border-color: #30363d;
  }
  .gh-card__names {
    min-width: 0;
    font-size: 14px;
    line-height: 1.25;
    font-weight: 600;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .gh-card__namespace {
    color: #656d76;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dark .gh-card__namespace { color: #8b949e; }
  .gh-card__slash { color: inherit; }
  .gh-card__title {
    color: var(--gh-accent, #0969da);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .gh-card:hover .gh-card__title {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }
  .gh-card__action {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: #f6f8fa;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    border: 1px solid #d0d7de;
  }
  .gh-card__action > span {
    font-size: 15px;
    line-height: 1;
    color: #1f2328;
  }
  .gh-card:hover .gh-card__action {
    background: var(--gh-accent, #0969da);
    transform: scale(1.05);
    border-color: var(--gh-accent, #0969da);
  }
  .gh-card:hover .gh-card__action > span { color: #fff; }
  .dark .gh-card__action {
    background: #21262d;
    border-color: #30363d;
  }
  .dark .gh-card__action > span { color: #e6edf3; }
  .dark .gh-card:hover .gh-card__action {
    background: var(--gh-accent, #2f81f7);
    border-color: var(--gh-accent, #2f81f7);
  }

  /* ===== 描述 ===== */
  .gh-card__desc {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: #656d76;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
  }
  .dark .gh-card__desc { color: #8b949e; }

  /* ===== 底部 ===== */
  .gh-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 12px;
    line-height: 1;
    color: #656d76;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
  }
  .dark .gh-card__foot { color: #8b949e; }
  .gh-card__stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .gh-card__stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: inherit;
  }
  .gh-card__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: #656d76;
  }
  .dark .gh-card__icon { color: #8b949e; }
  .gh-card:hover .gh-card__icon {
    color: var(--gh-accent, #0969da);
  }

  /* 右侧 pills */
  .gh-card__pills {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    flex-wrap: wrap;
  }
  .gh-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    line-height: 18px;
    background: #f6f8fa;
    color: #1f2328;
    white-space: nowrap;
  }
  .dark .gh-card__pill {
    background: #21262d;
    color: #e6edf3;
  }
  .gh-card__pill-license .gh-card__icon {
    width: 12px;
    height: 12px;
  }
  .gh-card__lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--gh-lang-dot, var(--gh-accent, #0969da));
    flex-shrink: 0;
  }
</style>
