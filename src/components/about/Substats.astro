---
import { type IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

interface SubstatsItem {
  platform: string
  icon: IconsType
  color?: string
  link?: string
  text: string
  api?: string
  count?: number
}

type Props = {
  stats: SubstatsItem[]
}

const { stats } = Astro.props as Props
---

<div class='grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 sm:p-3'>
  {
    stats.map(({ link, platform, icon, color, count, text, api }) => (
      <a
        class='group text-muted-foreground no-underline'
        href={link}
        target='_blank'
        rel='noopener noreferrer'
      >
        <div class='flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all hover:border-border hover:bg-muted'>
          {icon && <Icon name={icon} color={color} />}
          <div class='flex-1 text-foreground transition-colors group-hover:text-primary'>
            {platform}
          </div>
          <div class='flex items-center gap-1.5'>
            <samp data-count data-api={api}>{count ?? '…'}</samp>
            <span class='text-sm font-normal'>{text}</span>
          </div>
        </div>
      </a>
    ))
  }
</div>
<div class='mt-2 text-right text-sm'>
  Display real-time; powered by <a
    class='text-muted-foreground'
    href='http://github.com/spencerwooo/substats'
    target='_blank'
    rel='noopener noreferrer'>Substats</a
  >
</div>

<script>
  async function fetchCount(api: string): Promise<number | null> {
    try {
      const response = await fetch(`https://api.swo.moe/stats/${api}`)
      const data = await response.json()
      if (data.failed) return null
      return data.count
    } catch {
      return null
    }
  }

  async function init() {
    const els = document.querySelectorAll<HTMLElement>('samp[data-count]')
    for (const el of els) {
      const api = el.getAttribute('data-api')
      if (!api) continue
      const count = await fetchCount(api)
      if (count !== null) el.textContent = String(count)
    }
  }

  init()
</script>