<dialog id='wechat-dialog' class='max-w-[calc(100vw-2rem)] rounded-2xl border bg-background p-6 shadow-lg'>
  <div class='flex flex-col items-center gap-4'>
    <p class='text-base font-medium'>微信扫码添加</p>
    <img src='/images/WeChat.jpg' alt='WeChat 二维码' class='w-80 max-w-full rounded-lg' />
    <p class='text-sm text-muted-foreground'>添加时请备注来意，感谢配合 👋</p>
    <button
      id='wechat-close'
      type='button'
      class='gemini-btn rounded-full px-4 py-1 text-sm text-white'
  >
      关闭
    </button>
  </div>
</dialog>

<dialog id='email-dialog' class='max-w-[calc(100vw-2rem)] rounded-2xl border bg-background p-6 shadow-lg'>
  <div class='flex flex-col items-center gap-4'>
    <p class='text-base font-medium'>我的邮箱</p>
    <p class='select-all rounded-lg bg-muted px-4 py-2 text-sm'>wanfeng572@gmail.com</p>
    <div class='flex gap-2'>
      <button
        id='email-copy'
        type='button'
        class='gemini-btn rounded-full px-4 py-1 text-sm text-white'
        >
        复制
      </button>
      <button
        id='email-close'
        type='button'
        class='gemini-btn rounded-full px-4 py-1 text-sm text-white'
        >
        关闭
      </button>
    </div>
  </div>
</dialog>

<script>
  const wechatBtn = document.getElementById('wechat-btn')
  const wechatDialog = document.getElementById('wechat-dialog') as HTMLDialogElement | null
  const wechatClose = document.getElementById('wechat-close')
  wechatBtn?.addEventListener('click', () => wechatDialog?.showModal())
  wechatClose?.addEventListener('click', () => wechatDialog?.close())
  wechatDialog?.addEventListener('click', (e) => {
    if (e.target === wechatDialog) wechatDialog.close()
  })

  const EMAIL = 'wanfeng572@gmail.com'
  const emailBtn = document.getElementById('email-btn')
  const emailDialog = document.getElementById('email-dialog') as HTMLDialogElement | null
  const emailClose = document.getElementById('email-close')
  const emailCopy = document.getElementById('email-copy')
  emailBtn?.addEventListener('click', () => emailDialog?.showModal())
  emailClose?.addEventListener('click', () => emailDialog?.close())
  emailDialog?.addEventListener('click', (e) => {
    if (e.target === emailDialog) emailDialog.close()
  })
  emailCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(EMAIL)
      if (emailCopy) emailCopy.textContent = '已复制'
      setTimeout(() => emailCopy && (emailCopy.textContent = '复制'), 1500)
    } catch {
      if (emailCopy) emailCopy.textContent = '复制失败'
    }
  })
</script>

<style>
  #wechat-dialog::backdrop,
  #email-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
</style>
