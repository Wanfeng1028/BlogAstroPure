---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ActivityHeatmap from '@/components/home/ActivityHeatmap.astro'
import ProfileLinks from '@/components/home/ProfileLinks.astro'
import Section from '@/components/home/Section.astro'
import config from '@/site-config'

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// Build activity heatmap data: blog posts + GitHub push events
const activityData: Record<string, number> = {}

// Blog post dates
for (const post of allPosts) {
  const d = post.data.publishDate
  if (d) {
    const key = new Date(d).toISOString().slice(0, 10)
    activityData[key] = (activityData[key] || 0) + 2
  }
}

// GitHub public events (push = commits)
try {
  for (let page = 1; page <= 3; page++) {
    const res = await fetch(
      `https://api.github.com/users/Wanfeng1028/events/public?per_page=100&page=${page}`,
      { headers: { 'User-Agent': 'AstroBlog' }, signal: AbortSignal.timeout(5000) }
    )
    if (!res.ok) break
    const events: { type: string; created_at: string; payload?: { commits?: unknown[] } }[] =
      await res.json()
    if (!events.length) break
    for (const ev of events) {
      if (ev.type === 'PushEvent') {
        const key = ev.created_at.slice(0, 10)
        const commits = ev.payload?.commits?.length || 1
        activityData[key] = (activityData[key] || 0) + commits
      }
    }
  }
} catch {
  // GitHub API unavailable during build — blog data only
}
---

<PageLayout meta={{ title: '首页' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='avatar-ring-wrap'>
        <div class='avatar-ring'></div>
        <div class='avatar-ring-glow'></div>
        <img
          src={config.logo.src}
          alt={config.logo.alt || '头像'}
          class='h-28 w-auto rounded-full'
          loading='eager'
          fetchpriority='high'
        />
      </div>

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        <ProfileLinks showBadges={false} />
      </div>

      <p class='mt-2 max-w-xl text-center text-xs font-bold italic leading-relaxed text-muted-foreground'>
        每个优秀的人都有一段沉默的时光，那段时光是付出了很多努力，却得不到结果的日子，我们把它叫做扎根。
      </p>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <ActivityHeatmap data={activityData} />

      <Section title='关于'>
        <p class='text-muted-foreground'>GIS 开发 / 全栈开发</p>
        <p class='text-muted-foreground'>
          专业方向：GIS 开发，全栈开发（进行中）；本科期间做过遥感智能识别、计算机视觉相关的研究；毕业前在浙江建投数字技术有限公司做过前端开发实习。目前在学习
          Agent 和 Go 后端开发。
        </p>
        <Button title='了解更多' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      <Section title='Website List'>
        <div class='not-prose grid gap-4 sm:grid-cols-2'>
          <a href='https://github.com/Wanfeng1028/ParrotSoundReVue' target='_blank' rel='noopener'
            class='group overflow-hidden rounded-xl border bg-muted/40 transition-colors hover:bg-muted'>
            <div class='flex h-28 items-center justify-center bg-muted/60'>
              <span class='text-3xl'>🦜</span>
            </div>
            <div class='p-4'>
              <p class='text-sm font-semibold'>ParrotSoundReVue</p>
              <p class='mt-1 text-xs text-muted-foreground'>基于 Vue 的智能语音识别应用</p>
            </div>
          </a>
          <a href='https://github.com/Wanfeng1028/BlogAstroPure' target='_blank' rel='noopener'
            class='group overflow-hidden rounded-xl border bg-muted/40 transition-colors hover:bg-muted'>
            <div class='flex h-28 items-center justify-center bg-muted/60'>
              <span class='text-3xl'>📝</span>
            </div>
            <div class='p-4'>
              <p class='text-sm font-semibold'>BlogAstroPure</p>
              <p class='mt-1 text-xs text-muted-foreground'>基于 Astro 的个人博客</p>
            </div>
          </a>
          <a href='https://github.com/Wanfeng1028/GeoFrontend2.0' target='_blank' rel='noopener'
            class='group overflow-hidden rounded-xl border bg-muted/40 transition-colors hover:bg-muted'>
            <div class='flex h-28 items-center justify-center bg-muted/60'>
              <span class='text-3xl'>🌍</span>
            </div>
            <div class='p-4'>
              <p class='text-sm font-semibold'>GeoFrontend2.0</p>
              <p class='mt-1 text-xs text-muted-foreground'>GIS 工作台前端</p>
            </div>
          </a>
          <a href='https://github.com/Wanfeng1028' target='_blank' rel='noopener'
            class='group flex flex-col items-center justify-center rounded-xl border border-dashed p-4 text-center transition-colors hover:bg-muted/40'>
            <p class='text-sm font-semibold'>More projects</p>
            <p class='mt-1 text-xs text-muted-foreground'>GitHub 上查看更多 →</p>
          </a>
        </div>
      </Section>

      <Section title='Skills'>
        <div class='not-prose flex flex-col gap-4'>
          <div>
            <p class='mb-2 text-sm font-medium text-muted-foreground'>Languages</p>
            <div class='flex flex-wrap gap-2'>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>TypeScript</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>JavaScript</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Go</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Python</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Java</span>
            </div>
          </div>
          <div>
            <p class='mb-2 text-sm font-medium text-muted-foreground'>Frontend</p>
            <div class='flex flex-wrap gap-2'>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Vue</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>React</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Angular</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Astro</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Vite</span>
            </div>
          </div>
          <div>
            <p class='mb-2 text-sm font-medium text-muted-foreground'>Backend & Tools</p>
            <div class='flex flex-wrap gap-2'>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Node.js</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Gin</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Docker</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>PostgreSQL</span>
              <span class='rounded-full bg-muted px-3 py-1 text-sm'>Git</span>
            </div>
          </div>
        </div>
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='文章'>
            <ul class='flex flex-col gap-y-4 text-start'>
              {allPostsByDate.map((p) => (
                <PostPreview post={p} detailed />
              ))}
            </ul>
            <Button title='更多文章' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }
    </div>
  </main>
</PageLayout>
