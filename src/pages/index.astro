---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ActivityHeatmap from '@/components/home/ActivityHeatmap.astro'
import ProfileLinks from '@/components/home/ProfileLinks.astro'
import Section from '@/components/home/Section.astro'
import config from '@/site-config'
import { heatmapWorkerUrl } from '@/site-config'

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

// Skills 分类（icons 为 skillicons.dev 图标名，逗号分隔）
const skills = [
  { title: 'OS', icons: 'apple,linux,windows,ubuntu,debian,arch' },
  {
    title: 'Language & Frameworks',
    icons: 'ts,js,go,python,java,vue,react,angular,astro,vite,nodejs,gin'
  },
  { title: 'Tool', icons: 'docker,postgres,git,vscode' }
]

// Build activity heatmap data: blog posts (GitHub push 数据由 Worker 在前端运行时拉取)
const activityData: Record<string, number> = {}

// Blog post dates
for (const post of allPosts) {
  const d = post.data.publishDate
  if (d) {
    const key = new Date(d).toISOString().slice(0, 10)
    activityData[key] = (activityData[key] || 0) + 2
  }
}
---

<PageLayout meta={{ title: '首页' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='avatar-ring-wrap'>
        <div class='avatar-ring'></div>
        <div class='avatar-ring-glow'></div>
        <img
          src={config.logo.src}
          alt={config.logo.alt || '头像'}
          class='h-28 w-auto rounded-full'
          loading='eager'
          fetchpriority='high'
        />
      </div>

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        <ProfileLinks showBadges={false} />
      </div>

      <p class='mt-2 max-w-xl text-center text-xs font-bold italic leading-relaxed text-muted-foreground'>
        每个优秀的人都有一段沉默的时光，那段时光是付出了很多努力，却得不到结果的日子，我们把它叫做扎根。
      </p>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <ActivityHeatmap blogData={activityData} workerUrl={heatmapWorkerUrl} />

      <Section title='Website List'>
        <div class='not-prose grid gap-4 sm:grid-cols-2'>
          <a href='https://github.com/Wanfeng1028/ParrotSoundReVue' target='_blank' rel='noopener'
            class='tilt-card accent-card group relative flex flex-col gap-4 overflow-hidden rounded-2xl border p-5 transition-[border-color,box-shadow] duration-300'
            data-tilt='' style='--accent: #6366f1'>
            <div class='flex items-center justify-between'>
              <div
                class='accent-icon flex size-12 items-center justify-center rounded-xl text-2xl transition-transform duration-300 group-hover:scale-110'>
                🦜
              </div>
              <span class='rounded-full border border-border bg-muted px-2.5 py-0.5 text-xs text-muted-foreground'>GitHub</span>
            </div>
            <div>
              <p class='accent-title text-base font-semibold'>ParrotSoundReVue</p>
              <p class='mt-1 text-sm leading-relaxed text-muted-foreground'>基于 Vue 的智能语音识别应用</p>
            </div>
            <div class='mt-auto flex flex-wrap gap-1.5'>
              <span class='accent-tag rounded-full px-2.5 py-0.5 text-xs'>Vue</span>
              <span class='accent-tag rounded-full px-2.5 py-0.5 text-xs'>语音识别</span>
            </div>
          </a>
          <a href='https://github.com/Wanfeng1028/BlogAstroPure' target='_blank' rel='noopener'
            class='tilt-card accent-card group relative flex flex-col gap-4 overflow-hidden rounded-2xl border p-5 transition-[border-color,box-shadow] duration-300'
            data-tilt='' style='--accent: #f97316'>
            <div class='flex items-center justify-between'>
              <div
                class='accent-icon flex size-12 items-center justify-center rounded-xl text-2xl transition-transform duration-300 group-hover:scale-110'>
                📝
              </div>
              <span class='rounded-full border border-border bg-muted px-2.5 py-0.5 text-xs text-muted-foreground'>GitHub</span>
            </div>
            <div>
              <p class='accent-title text-base font-semibold'>BlogAstroPure</p>
              <p class='mt-1 text-sm leading-relaxed text-muted-foreground'>基于 Astro 的个人博客</p>
            </div>
            <div class='mt-auto flex flex-wrap gap-1.5'>
              <span class='accent-tag rounded-full px-2.5 py-0.5 text-xs'>Astro</span>
              <span class='accent-tag rounded-full px-2.5 py-0.5 text-xs'>TypeScript</span>
            </div>
          </a>
        </div>
        <Button title='查看更多' class='w-fit self-end' href='https://github.com/Wanfeng1028' variant='ahead' />
      </Section>

      <Section title='Skills'>
        <div class='not-prose flex flex-col gap-5'>
          {
            skills.map((cat) => (
              <div>
                <p class='mb-2 text-sm font-semibold text-muted-foreground'>{cat.title}</p>
                <img
                  src={`https://skillicons.dev/icons?i=${cat.icons}&perline=15&theme=light`}
                  alt={cat.title}
                  class='max-w-full'
                  loading='lazy'
                />
              </div>
            ))
          }
        </div>
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='文章'>
            <ul class='flex flex-col gap-y-4 text-start'>
              {allPostsByDate.map((p) => (
                <PostPreview post={p} detailed />
              ))}
            </ul>
            <Button title='更多文章' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }
    </div>
  </main>
</PageLayout>

<script>
  import { initTilt } from '@/utils/tilt'
  initTilt()
</script>
