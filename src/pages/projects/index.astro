---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import CertificateCard from '@/components/projects/CertificateCard.astro'
import PublicationCard from '@/components/projects/PublicationCard.astro'
import { PROJECTS, CERTIFICATES, PUBLICATIONS } from '@/data/projects'

// ===== 统一数据从 src/data/projects.ts 读取（首页共用此数据源） =====
const items = [
  ...PROJECTS.map((p) => ({ ...p, type: 'project' as const })),
  ...CERTIFICATES.map((c) => ({ ...c, type: 'certificate' as const })),
  ...PUBLICATIONS.map((p) => ({ ...p, type: 'publication' as const }))
]

const projectCount = PROJECTS.length
const certificateCount = CERTIFICATES.length
const publicationCount = PUBLICATIONS.length
const showPublicationsTab = publicationCount > 0
---

<PageLayout title='Projects & Publications' hideSidebar view>
  <div class='pub-page'>
    {/* 居中分段切换按钮（滑块动效） */}
    <div class='pub-toggle' id='pub-toggle' role='tablist' aria-label='筛选展示内容'>
      <span class='pub-toggle__indicator' id='pub-indicator' aria-hidden='true'></span>
      <button class='pub-toggle__btn is-active' data-filter='all' role='tab' aria-selected='true'>
        全部 <span class='pub-toggle__count'>{items.length}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='project' role='tab' aria-selected='false'>
        Projects <span class='pub-toggle__count'>{projectCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='certificate' role='tab' aria-selected='false'>
        Certificates <span class='pub-toggle__count'>{certificateCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='publication' role='tab' aria-selected='false'>
        Publications <span class='pub-toggle__count'>{publicationCount}</span>
      </button>
    </div>

    {/* 内容区：使用三个独立卡片组件渲染 */}
    <div id='pub-content' class='pub-content'>
      {
        items.map((item) =>
          item.type === 'project' ? (
            <ProjectCard
              href={item.href}
              namespace={item.namespace}
              title={item.title}
              description={item.description}
              primaryLang={item.primaryLang}
              stars={item.stars}
              forks={item.forks}
              license={item.license}
              accent={item.accent}
              deco={item.deco}
              actionIcon={item.actionIcon}
              dataType='project'
            />
          ) : item.type === 'certificate' ? (
            <CertificateCard
              href={item.href}
              issuer={item.issuer}
              title={item.title}
              description={item.description}
              year={item.year}
              validity={item.validity}
              certType={item.certType}
              category={item.category}
              accent={item.accent}
              deco={item.deco}
              actionIcon={item.actionIcon}
              dataType='certificate'
            />
          ) : (
            <PublicationCard
              href={item.href}
              firstAuthor={item.firstAuthor}
              coAuthorCount={item.coAuthorCount}
              authors={item.authors}
              title={item.title}
              description={item.description}
              year={item.year}
              citations={item.citations}
              accessLabel={item.accessLabel}
              venue={item.venue}
              field={item.field}
              authorSeparator={item.authorSeparator}
              accent={item.accent}
              deco={item.deco}
              actionIcon={item.actionIcon}
              dataType='publication'
            />
          )
        )
      }

      {/* 空状态占位：Projects/Certificates/Publications 某分类数量为0时显示"等待更新ing..." */}
      <div id='pub-empty' class='pub-empty' aria-live='polite'>
        <div class='pub-empty__icon' aria-hidden='true'>
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M12 2v4'/>
            <path d='M12 18v4'/>
            <path d='m4.93 4.93 2.83 2.83'/>
            <path d='m16.24 16.24 2.83 2.83'/>
            <path d='M2 12h4'/>
            <path d='M18 12h4'/>
            <path d='m4.93 19.07 2.83-2.83'/>
            <path d='m16.24 7.76 2.83-2.83'/>
            <circle cx='12' cy='12' r='4'/>
          </svg>
        </div>
        <p class='pub-empty__text'>
          等待更新<span class='pub-empty__dots'><i>.</i><i>.</i><i>.</i></span>
        </p>
        <p class='pub-empty__hint'>相关内容正在整理中，敬请期待</p>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { initTilt } from '@/utils/tilt'

  const toggle = document.getElementById('pub-toggle')
  const buttons = toggle?.querySelectorAll<HTMLElement>('.pub-toggle__btn')
  const indicator = document.getElementById('pub-indicator')
  const items = document.querySelectorAll<HTMLElement>('#pub-content [data-type]')
  const empty = document.getElementById('pub-empty')

  /** 控制空状态占位「等待更新ing...」的显隐：当当前可见卡片数 === 0 时才显示 */
  function syncEmptyVisibility() {
    if (!empty) return
    let visibleCount = 0
    items.forEach((item) => { if (!item.classList.contains('is-hidden')) visibleCount++ })
    // 注意 pub-empty 本身也在 grid 里，要让它占满整行
    empty.classList.toggle('is-hidden', visibleCount !== 0)
  }

  function moveIndicator(btn: Element | undefined) {
    if (!indicator || !btn) return
    const el = btn as HTMLElement
    indicator.style.left = `${el.offsetLeft}px`
    indicator.style.width = `${el.offsetWidth}px`
  }

  function onSelect(btn: HTMLElement) {
    buttons?.forEach((b) => {
      b.classList.toggle('is-active', b === btn)
      b.setAttribute('aria-selected', b === btn ? 'true' : 'false')
    })
    moveIndicator(btn)
    const filter = btn.dataset.filter
    items.forEach((item) => {
      const show = filter === 'all' || item.dataset.type === filter
      item.classList.toggle('is-hidden', !show)
    })
    syncEmptyVisibility()
  }

  buttons?.forEach((btn) => btn.addEventListener('click', () => onSelect(btn)))

  window.addEventListener('load', () => {
    moveIndicator(buttons?.[0])
    syncEmptyVisibility()
  })
  window.addEventListener('resize', () => {
    const active = buttons?.[0]?.parentElement?.querySelector('.is-active') ?? buttons?.[0]
    moveIndicator(active)
  })

  // 3D Tilt 反光卡片交互（三个新卡片组件都启用，WebListCard 同款效果）
  initTilt('#pub-content .tilt-card[data-tilt]')
</script>

<style>
  .pub-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 分段切换按钮 —— Gemini 官方最终版（全部官方真实值） */
  .pub-toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px;
    border: 1px solid #e5e5e5;
    border-radius: 100px;
    background: #ffffff;
    box-shadow: none;
    margin-bottom: 2rem;
    font-family: 'Google Sans', Roboto, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  .pub-toggle__indicator {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    border-radius: 100px;
    background: linear-gradient(89.58deg, #3186ff 0.28%, #346bf0 44.45%, #4ea0ff 99.55%);
    transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1), width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .pub-toggle .pub-toggle__btn {
    position: relative;
    z-index: 1;
    appearance: none;
    border: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: #5f6368;
    padding: 12px 24px;
    border-radius: 100px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.3s ease, background 0.3s ease;
  }
  .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: #f4f4f5;
  }
  .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }

  .pub-toggle .pub-toggle__count {
    font-size: 0.78rem;
    font-weight: 500;
    background: transparent;
    opacity: 0.55;
  }
  .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
    opacity: 0.9;
    color: #fff;
  }

  .dark .pub-toggle {
    background: #1f2128;
    border-color: #3a3d45;
  }
  .dark .pub-toggle .pub-toggle__btn {
    color: #9aa0a6;
  }
  .dark .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: rgba(255, 255, 255, 0.08);
  }
  .dark .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__count,
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    color: #fff;
  }

  /* 移动端 tabs 适配：缩小字号/padding，允许横向滑动 */
  @media (max-width: 640px) {
    .pub-toggle {
      width: 100%;
      gap: 2px;
      padding: 2px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-bottom: 1.25rem;
      justify-content: flex-start;
    }
    .pub-toggle::-webkit-scrollbar { display: none; }
    .pub-toggle .pub-toggle__btn {
      font-size: 15px;
      padding: 10px 14px;
      gap: 6px;
      flex: 0 0 auto;
    }
    .pub-toggle .pub-toggle__count {
      font-size: 0.7rem;
    }
  }

  /* 内容区 */
  .pub-content {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* 筛选隐藏 */
  .pub-content .is-hidden {
    display: none;
  }

  /* 桌面端双列：全部卡片（Projects / Certificates / Publications）统一一行两个 */
  @media (min-width: 640px) {
    .pub-content {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 空状态占位「等待更新ing...」 */
  .pub-empty {
    grid-column: 1 / -1; /* 占满整行（无论单列/双列） */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 72px 24px 80px;
    border-radius: 14px;
    border: 1.5px dashed #cfd5de;
    background:
      radial-gradient(1200px 400px at 50% -100px, rgba(78,160,255,0.08), transparent 60%),
      linear-gradient(180deg, rgba(250,251,253,0.9) 0%, rgba(246,248,251,0.6) 100%);
    color: #6b7280;
    text-align: center;
    user-select: none;
    min-height: 320px;
  }
  .pub-empty.is-hidden {
    display: none;
  }
  .pub-empty__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(78,160,255,0.12);
    color: #346bf0;
    animation: pub-empty-spin 8s linear infinite;
  }
  .pub-empty__icon svg {
    width: 30px;
    height: 30px;
  }
  .pub-empty__text {
    font-size: 22px;
    font-weight: 600;
    color: #374151;
    letter-spacing: 0.5px;
    margin: 0;
  }
  .pub-empty__dots i {
    font-style: normal;
    display: inline-block;
    margin: 0 1px;
    animation: pub-empty-dot 1.4s infinite ease-in-out both;
  }
  .pub-empty__dots i:nth-child(1) { animation-delay: -0.32s; }
  .pub-empty__dots i:nth-child(2) { animation-delay: -0.16s; }
  .pub-empty__hint {
    font-size: 14px;
    color: #9aa0a6;
    margin: 0;
  }

  .dark .pub-empty {
    border-color: #3a3d45;
    background:
      radial-gradient(1200px 400px at 50% -100px, rgba(78,160,255,0.12), transparent 60%),
      linear-gradient(180deg, rgba(15,23,42,0.55) 0%, rgba(13,17,23,0.45) 100%);
    color: #94a3b8;
  }
  .dark .pub-empty__icon {
    background: rgba(78,160,255,0.18);
    color: #4ea0ff;
  }
  .dark .pub-empty__text {
    color: #e5e7eb;
  }

  @keyframes pub-empty-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes pub-empty-dot {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
    40%           { transform: scale(1);   opacity: 1;   }
  }
</style>
