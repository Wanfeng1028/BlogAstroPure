---
import PageLayout from '@/layouts/CommonPage.astro'
import WebListCard from '@/components/home/WebListCard.astro'

// 数据：可后续迁移到 content 集合或独立数据文件
interface ProjectItem {
  type: 'project'
  title: string
  description: string
  tech: { text: string; color: 'purple' | 'aqua' | 'green' | 'orange' | 'blue' | 'pink' | 'red' | 'yellow' }[]
  link: string
  accent: string
  deco: string
  decoImg: string
  imgBg: string
  imgTone: string
}
interface CertificateItem {
  type: 'certificate'
  title: string
  issuer: string
  year: number
  description: string
  link: string
  accent: string
  deco: string
  decoImg: string
  imgBg: string
  imgTone: string
}
interface PublicationItem {
  type: 'publication'
  title: string
  authors: string[]
  venue: string
  year: number
  description: string
  link: string
  accent: string
  deco: string
  decoImg: string
  imgBg: string
  imgTone: string
}
type Item = ProjectItem | CertificateItem | PublicationItem

type TagColor = 'purple' | 'aqua' | 'green' | 'orange' | 'blue' | 'pink' | 'red' | 'yellow'

const items: Item[] = [
  // ===== Projects =====
  {
    type: 'project',
    title: 'ParrotSoundReVue',
    description: '基于 Vue 的智能语音识别应用，曾获一个奖项。',
    tech: [
      { text: 'Vue', color: 'aqua' },
      { text: 'TypeScript', color: 'blue' },
      { text: 'Vite', color: 'purple' }
    ],
    link: 'https://github.com/Wanfeng1028/ParrotSoundReVue',
    accent: '#6366f1',
    deco: '🦜',
    decoImg: '/images/social-card.png',
    imgBg: 'linear-gradient(135deg, #e0e7ff 0%, #818cf8 55%, #4f46e5 100%)',
    imgTone: '#6366f1'
  },
  {
    type: 'project',
    title: 'BlogAstroPure',
    description: '基于 Astro 的个人博客，当前本站。',
    tech: [
      { text: 'Astro', color: 'aqua' },
      { text: 'TypeScript', color: 'blue' },
      { text: 'Tailwind', color: 'green' }
    ],
    link: 'https://github.com/Wanfeng1028/BlogAstroPure',
    accent: '#f97316',
    deco: '📝',
    decoImg: '/images/touxiang.png',
    imgBg: 'linear-gradient(135deg, #ffedd5 0%, #fb923c 55%, #ea580c 100%)',
    imgTone: '#f97316'
  },
  {
    type: 'project',
    title: 'GeoFrontend2.0',
    description: 'GIS 工作台前端，聚焦遥感智能识别与可视化。',
    tech: [
      { text: 'GIS', color: 'green' },
      { text: 'JavaScript', color: 'yellow' },
      { text: 'Vue', color: 'aqua' }
    ],
    link: 'https://github.com/Wanfeng1028/GeoFrontend2.0',
    accent: '#10b981',
    deco: '🗺️',
    decoImg: '/images/social-card.png',
    imgBg: 'linear-gradient(135deg, #d1fae5 0%, #34d399 55%, #059669 100%)',
    imgTone: '#10b981'
  },
  // ===== Certificates =====
  {
    type: 'certificate',
    title: '示例：前端开发工程师认证',
    issuer: '示例机构 / 颁发方',
    year: 2026,
    description: '占位示例，请替换为你的真实证书名称、颁发机构与链接。',
    link: '#',
    accent: '#f59e0b',
    deco: '🏅',
    decoImg: '/images/social-card.png',
    imgBg: 'linear-gradient(135deg, #fef3c7 0%, #fbbf24 55%, #d97706 100%)',
    imgTone: '#f59e0b'
  },
  // ===== Publications =====
  {
    type: 'publication',
    title: '示例：遥感影像语义分割方法研究',
    authors: ['Wanfeng', 'Coauthor'],
    venue: '示例期刊 / 会议',
    year: 2026,
    description: '占位示例，请替换为你的真实论文、作者与链接。',
    link: '#',
    accent: '#8b5cf6',
    deco: '📄',
    decoImg: '/images/social-card.png',
    imgBg: 'linear-gradient(135deg, #ede9fe 0%, #a78bfa 55%, #7c3aed 100%)',
    imgTone: '#8b5cf6'
  },
  {
    type: 'publication',
    title: '示例：基于深度学习的作物识别综述',
    authors: ['Wanfeng'],
    venue: '示例会议',
    year: 2025,
    description: '占位示例，请替换为你的真实论文、作者与链接。',
    link: '#',
    accent: '#06b6d4',
    deco: '📑',
    decoImg: '/images/social-card.png',
    imgBg: 'linear-gradient(135deg, #cffafe 0%, #22d3ee 55%, #0891b2 100%)',
    imgTone: '#06b6d4'
  }
]

const projectCount = items.filter((i) => i.type === 'project').length
const certificateCount = items.filter((i) => i.type === 'certificate').length
const publicationCount = items.filter((i) => i.type === 'publication').length

// 生成证书的 tags
function certTags(item: CertificateItem): { text: string; color: TagColor }[] {
  const tags: { text: string; color: TagColor }[] = []
  if (item.issuer) tags.push({ text: item.issuer, color: 'orange' })
  if (item.year) tags.push({ text: String(item.year), color: 'yellow' })
  return tags
}

// 生成出版物的 tags
function pubTags(item: PublicationItem): { text: string; color: TagColor }[] {
  const tags: { text: string; color: TagColor }[] = []
  if (item.authors?.length) tags.push({ text: item.authors.join(', '), color: 'purple' })
  if (item.venue) tags.push({ text: item.venue, color: 'aqua' })
  if (item.year) tags.push({ text: String(item.year), color: 'blue' })
  return tags
}
---

<PageLayout title='Projects & Publications' hideSidebar view>
  <div class='pub-page'>
    {/* 居中分段切换按钮（滑块动效） */}
    <div class='pub-toggle' id='pub-toggle' role='tablist' aria-label='筛选展示内容'>
      <span class='pub-toggle__indicator' id='pub-indicator' aria-hidden='true'></span>
      <button class='pub-toggle__btn is-active' data-filter='all' role='tab' aria-selected='true'>
        全部 <span class='pub-toggle__count'>{items.length}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='project' role='tab' aria-selected='false'>
        Projects <span class='pub-toggle__count'>{projectCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='certificate' role='tab' aria-selected='false'>
        Certificates <span class='pub-toggle__count'>{certificateCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='publication' role='tab' aria-selected='false'>
        Publications <span class='pub-toggle__count'>{publicationCount}</span>
      </button>
    </div>

    {/* 内容区：全部统一使用 WebListCard 卡片组件 */}
    <div id='pub-content' class='pub-content'>
      {
        items.map((item) =>
          item.type === 'project' ? (
            <WebListCard
              href={item.link}
              deco={item.deco}
              accent={item.accent}
              decoImg={item.decoImg}
              imgBg={item.imgBg}
              imgTone={item.imgTone}
              headline={item.title}
              description={item.description}
              tags={item.tech}
              dataType='project'
            />
          ) : item.type === 'certificate' ? (
            <WebListCard
              href={item.link}
              deco={item.deco}
              accent={item.accent}
              decoImg={item.decoImg}
              imgBg={item.imgBg}
              imgTone={item.imgTone}
              headline={item.title}
              description={item.description}
              tags={certTags(item)}
              dataType='certificate'
            />
          ) : (
            <WebListCard
              href={item.link}
              deco={item.deco}
              accent={item.accent}
              decoImg={item.decoImg}
              imgBg={item.imgBg}
              imgTone={item.imgTone}
              headline={item.title}
              description={item.description}
              tags={pubTags(item)}
              dataType='publication'
            />
          )
        )
      }
    </div>
  </div>
</PageLayout>

<script>
  import { initTilt } from '@/utils/tilt'

  const toggle = document.getElementById('pub-toggle')
  const buttons = toggle?.querySelectorAll<HTMLElement>('.pub-toggle__btn')
  const indicator = document.getElementById('pub-indicator')
  const items = document.querySelectorAll<HTMLElement>('#pub-content [data-type]')

  // 滑块移动到对应按钮
  function moveIndicator(btn: Element | undefined) {
    if (!indicator || !btn) return
    const el = btn as HTMLElement
    indicator.style.left = `${el.offsetLeft}px`
    indicator.style.width = `${el.offsetWidth}px`
  }

  function onSelect(btn: HTMLElement) {
    buttons?.forEach((b) => {
      b.classList.toggle('is-active', b === btn)
      b.setAttribute('aria-selected', b === btn ? 'true' : 'false')
    })
    moveIndicator(btn)
    const filter = btn.dataset.filter
    items.forEach((item) => {
      const show = filter === 'all' || item.dataset.type === filter
      item.classList.toggle('is-hidden', !show)
    })
  }

  buttons?.forEach((btn) => btn.addEventListener('click', () => onSelect(btn)))

  // 初始定位 + 窗口尺寸变化时重新定位
  window.addEventListener('load', () => moveIndicator(buttons?.[0]))
  window.addEventListener('resize', () => {
    const active = buttons?.[0]?.parentElement?.querySelector('.is-active') ?? buttons?.[0]
    moveIndicator(active)
  })

  // 3D Tilt 反光卡片交互（全部 WebListCard 卡片都启用）
  initTilt('#pub-content .tilt-card[data-tilt]')
</script>

<style>
  .pub-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 分段切换按钮 —— Gemini 官方最终版（全部官方真实值） */
  /* 容器 */
  .pub-toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px; /* 官方：3px */
    border: 1px solid #e5e5e5; /* 官方：--theme-border-color */
    border-radius: 100px; /* 官方：100px */
    background: #ffffff;
    box-shadow: none; /* 官方：无投影 */
    margin-bottom: 2rem;
    font-family: 'Google Sans', Roboto, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  /* 滑动指示条：官方渐变胶囊，随激活项滑动 */
  .pub-toggle__indicator {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    border-radius: 100px;
    background: linear-gradient(89.58deg, #3186ff 0.28%, #346bf0 44.45%, #4ea0ff 99.55%);
    transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1), width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  /* 按钮 */
  .pub-toggle .pub-toggle__btn {
    position: relative;
    z-index: 1;
    appearance: none;
    border: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 18px; /* 官方：18px */
    font-weight: 500;
    line-height: 1.4; /* 官方：1.4 */
    color: #5f6368; /* 官方：--theme-text-color-secondary */
    padding: 12px 24px; /* 官方：12px 24px */
    border-radius: 100px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px; /* 官方：gap 10px */
    transition: color 0.3s ease, background 0.3s ease;
  }
  .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: #f4f4f5;
  }

  /* 激活态：文字白、背景透明，由下方滑块提供官方渐变填充 */
  .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }

  /* 角标（自己的扩展，官方没有） */
  .pub-toggle .pub-toggle__count {
    font-size: 0.78rem;
    font-weight: 500;
    background: transparent;
    opacity: 0.55;
  }
  .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
    opacity: 0.9;
    color: #fff;
  }

  /* 暗色模式 */
  .dark .pub-toggle {
    background: #1f2128;
    border-color: #3a3d45;
  }
  .dark .pub-toggle .pub-toggle__btn {
    color: #9aa0a6;
  }
  .dark .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: rgba(255, 255, 255, 0.08);
  }
  .dark .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__count,
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    color: #fff;
  }

  /* 内容区 */
  .pub-content {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* 筛选隐藏 */
  .pub-content .is-hidden {
    display: none;
  }

  /* 桌面端双列：Projects 双列，Certificates/Publications 卡片全宽 */
  @media (min-width: 640px) {
    .pub-content {
      grid-template-columns: 1fr 1fr;
    }
    .pub-content [data-type='certificate'],
    .pub-content [data-type='publication'] {
      grid-column: 1 / -1;
    }
  }
</style>
