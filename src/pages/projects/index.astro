---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import CertificateCard from '@/components/projects/CertificateCard.astro'
import PublicationCard from '@/components/projects/PublicationCard.astro'

// 主语言圆点色（GitHub 官方语言色板近似值）
const LANG_DOT = {
  vue: '#41b883',
  ts: '#3178c6',
  astro: '#ff5d01',
  js: '#f1e05a',
  python: '#3572A5',
  jupyter: '#DA5B0B',
  tailwind: '#06b6d4',
  gis: '#10b981',
  vite: '#646cff'
} as const

// ===== 数据：可后续迁移到 content 集合或独立数据文件 =====
interface ProjectItem {
  type: 'project'
  href: string
  namespace?: string
  title: string
  description: string
  primaryLang: { text: string; dotColor?: string }
  tech?: { text: string; color: 'purple' | 'aqua' | 'green' | 'orange' | 'blue' | 'pink' | 'red' | 'yellow' }[]
  stars?: number | string
  forks?: number | string
  license?: string | false
  accent?: string
  deco?: string
  actionIcon?: string
}
interface CertificateItem {
  type: 'certificate'
  href: string
  issuer: string
  title: string
  description: string
  year: number
  validity?: string
  certType?: { text: string; dotColor?: string }
  category: { text: string; dotColor?: string }
  accent?: string
  deco?: string
  actionIcon?: string
}
interface PublicationItem {
  type: 'publication'
  href: string
  firstAuthor: string
  coAuthorCount?: number
  authors?: string[]
  title: string
  description: string
  year: number
  citations?: number | string
  accessLabel?: string
  venue: { text: string; dotColor?: string }
  field?: { text: string; dotColor?: string }
  authorSeparator?: string
  accent?: string
  deco?: string
  actionIcon?: string
}
type Item = ProjectItem | CertificateItem | PublicationItem

const items: Item[] = [
  // ===== Projects =====
  {
    type: 'project',
    href: 'https://github.com/Wanfeng1028/ParrotSoundReVue',
    namespace: 'Wanfeng1028',
    title: 'ParrotSoundReVue',
    description: '基于 Vue 的智能语音识别应用，曾获一个奖项。',
    primaryLang: { text: 'Vue', dotColor: LANG_DOT.vue },
    stars: 56,
    forks: 16,
    license: 'MIT',
    accent: '#0969da',
    deco: '🦜',
    actionIcon: '🐙'
  },
  {
    type: 'project',
    href: 'https://github.com/Wanfeng1028/BlogAstroPure',
    namespace: 'Wanfeng1028',
    title: 'BlogAstroPure',
    description: '基于 Astro 的个人博客，当前本站。',
    primaryLang: { text: 'Astro', dotColor: LANG_DOT.astro },
    stars: 0,
    forks: 0,
    license: 'MIT',
    accent: '#f97316',
    deco: '📝',
    actionIcon: '🐙'
  },
  {
    // ↓↓↓ GeoFrontend2.0 （用户参考卡片对应的项目）↓↓↓
    type: 'project',
    href: 'https://github.com/Wanfeng1028/GeoFrontend2.0',
    namespace: 'Wanfeng1028',
    title: 'GeoFrontend2.0',
    description: 'GIS 工作台前端，聚焦遥感智能识别与可视化。',
    primaryLang: { text: 'JavaScript', dotColor: LANG_DOT.js },
    stars: 0,
    forks: 0,
    license: false, // 无许可证：不显示 license pill
    accent: '#10b981', // GIS 主题绿
    deco: '🗺️',
    actionIcon: '🐙'
  },
  // ===== Certificates =====
  {
    type: 'certificate',
    href: '#',
    issuer: '示例机构 / 颁发方',
    title: '示例：前端开发工程师认证',
    description: '占位示例，请替换为你的真实证书名称、颁发机构与链接。',
    year: 2026,
    validity: '永久有效',
    certType: { text: 'Professional' },
    category: { text: '前端开发', dotColor: '#3178c6' },
    accent: '#d4a72c',
    deco: '🏅',
    actionIcon: '🔗'
  },
  // ===== Publications =====
  {
    type: 'publication',
    href: '#',
    firstAuthor: 'Wanfeng',
    coAuthorCount: 1,
    authors: ['Wanfeng', 'Coauthor'],
    title: '示例：遥感影像语义分割方法研究',
    description: '占位示例，请替换为你的真实论文、作者与链接。',
    year: 2026,
    citations: 12,
    accessLabel: 'DOI',
    venue: { text: '示例期刊', dotColor: '#8250df' },
    field: { text: '遥感科学', dotColor: '#10b981' },
    accent: '#8250df',
    deco: '📄',
    actionIcon: '📄'
  },
  {
    type: 'publication',
    href: '#',
    firstAuthor: 'Wanfeng',
    authors: ['Wanfeng'],
    title: '示例：基于深度学习的作物识别综述',
    description: '占位示例，请替换为你的真实论文、作者与链接。',
    year: 2025,
    citations: 3,
    accessLabel: 'Open Access',
    venue: { text: '示例会议', dotColor: '#06b6d4' },
    accent: '#06b6d4',
    deco: '📑',
    actionIcon: '📑'
  }
]

const projectCount = items.filter((i) => i.type === 'project').length
const certificateCount = items.filter((i) => i.type === 'certificate').length
const publicationCount = items.filter((i) => i.type === 'publication').length
---

<PageLayout title='Projects & Publications' hideSidebar view>
  <div class='pub-page'>
    {/* 居中分段切换按钮（滑块动效） */}
    <div class='pub-toggle' id='pub-toggle' role='tablist' aria-label='筛选展示内容'>
      <span class='pub-toggle__indicator' id='pub-indicator' aria-hidden='true'></span>
      <button class='pub-toggle__btn is-active' data-filter='all' role='tab' aria-selected='true'>
        全部 <span class='pub-toggle__count'>{items.length}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='project' role='tab' aria-selected='false'>
        Projects <span class='pub-toggle__count'>{projectCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='certificate' role='tab' aria-selected='false'>
        Certificates <span class='pub-toggle__count'>{certificateCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='publication' role='tab' aria-selected='false'>
        Publications <span class='pub-toggle__count'>{publicationCount}</span>
      </button>
    </div>

    {/* 内容区：使用三个独立卡片组件渲染 */}
    <div id='pub-content' class='pub-content'>
      {
        items.map((item) =>
          item.type === 'project' ? (
            <ProjectCard
              href={item.href}
              namespace={item.namespace}
              title={item.title}
              description={item.description}
              primaryLang={item.primaryLang}
              tech={item.tech}
              stars={item.stars}
              forks={item.forks}
              license={item.license}
              accent={item.accent}
              deco={item.deco}
              actionIcon={item.actionIcon}
              dataType='project'
            />
          ) : item.type === 'certificate' ? (
            <CertificateCard
              href={item.href}
              issuer={item.issuer}
              title={item.title}
              description={item.description}
              year={item.year}
              validity={item.validity}
              certType={item.certType}
              category={item.category}
              accent={item.accent}
              deco={item.deco}
              actionIcon={item.actionIcon}
              dataType='certificate'
            />
          ) : (
            <PublicationCard
              href={item.href}
              firstAuthor={item.firstAuthor}
              coAuthorCount={item.coAuthorCount}
              authors={item.authors}
              title={item.title}
              description={item.description}
              year={item.year}
              citations={item.citations}
              accessLabel={item.accessLabel}
              venue={item.venue}
              field={item.field}
              authorSeparator={item.authorSeparator}
              accent={item.accent}
              deco={item.deco}
              actionIcon={item.actionIcon}
              dataType='publication'
            />
          )
        )
      }
    </div>
  </div>
</PageLayout>

<script>
  import { initTilt } from '@/utils/tilt'

  const toggle = document.getElementById('pub-toggle')
  const buttons = toggle?.querySelectorAll<HTMLElement>('.pub-toggle__btn')
  const indicator = document.getElementById('pub-indicator')
  const items = document.querySelectorAll<HTMLElement>('#pub-content [data-type]')

  function moveIndicator(btn: Element | undefined) {
    if (!indicator || !btn) return
    const el = btn as HTMLElement
    indicator.style.left = `${el.offsetLeft}px`
    indicator.style.width = `${el.offsetWidth}px`
  }

  function onSelect(btn: HTMLElement) {
    buttons?.forEach((b) => {
      b.classList.toggle('is-active', b === btn)
      b.setAttribute('aria-selected', b === btn ? 'true' : 'false')
    })
    moveIndicator(btn)
    const filter = btn.dataset.filter
    items.forEach((item) => {
      const show = filter === 'all' || item.dataset.type === filter
      item.classList.toggle('is-hidden', !show)
    })
  }

  buttons?.forEach((btn) => btn.addEventListener('click', () => onSelect(btn)))

  window.addEventListener('load', () => moveIndicator(buttons?.[0]))
  window.addEventListener('resize', () => {
    const active = buttons?.[0]?.parentElement?.querySelector('.is-active') ?? buttons?.[0]
    moveIndicator(active)
  })

  // 3D Tilt 反光卡片交互（三个新卡片组件都启用，WebListCard 同款效果）
  initTilt('#pub-content .tilt-card[data-tilt]')
</script>

<style>
  .pub-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 分段切换按钮 —— Gemini 官方最终版（全部官方真实值） */
  .pub-toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px;
    border: 1px solid #e5e5e5;
    border-radius: 100px;
    background: #ffffff;
    box-shadow: none;
    margin-bottom: 2rem;
    font-family: 'Google Sans', Roboto, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  .pub-toggle__indicator {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    border-radius: 100px;
    background: linear-gradient(89.58deg, #3186ff 0.28%, #346bf0 44.45%, #4ea0ff 99.55%);
    transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1), width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .pub-toggle .pub-toggle__btn {
    position: relative;
    z-index: 1;
    appearance: none;
    border: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: #5f6368;
    padding: 12px 24px;
    border-radius: 100px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: color 0.3s ease, background 0.3s ease;
  }
  .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: #f4f4f5;
  }
  .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }

  .pub-toggle .pub-toggle__count {
    font-size: 0.78rem;
    font-weight: 500;
    background: transparent;
    opacity: 0.55;
  }
  .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
    opacity: 0.9;
    color: #fff;
  }

  .dark .pub-toggle {
    background: #1f2128;
    border-color: #3a3d45;
  }
  .dark .pub-toggle .pub-toggle__btn {
    color: #9aa0a6;
  }
  .dark .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: rgba(255, 255, 255, 0.08);
  }
  .dark .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__count,
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    color: #fff;
  }

  /* 内容区 */
  .pub-content {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* 筛选隐藏 */
  .pub-content .is-hidden {
    display: none;
  }

  /* 桌面端双列：Projects 双列，Certificates/Publications 卡片全宽 */
  @media (min-width: 640px) {
    .pub-content {
      grid-template-columns: 1fr 1fr;
    }
    .pub-content [data-type='certificate'],
    .pub-content [data-type='publication'] {
      grid-column: 1 / -1;
    }
  }
</style>
