---
import PageLayout from '@/layouts/CommonPage.astro'

// 数据：可后续迁移到 content 集合或独立数据文件
interface ProjectItem {
  type: 'project'
  title: string
  description: string
  tech: string[]
  link: string
  accent: string
}
interface CertificateItem {
  type: 'certificate'
  title: string
  issuer: string
  year: number
  description: string
  link: string
}
interface PublicationItem {
  type: 'publication'
  title: string
  authors: string[]
  venue: string
  year: number
  description: string
  link: string
}
type Item = ProjectItem | CertificateItem | PublicationItem

const items: Item[] = [
  // ===== Projects =====
  {
    type: 'project',
    title: 'ParrotSoundReVue',
    description: '基于 Vue 的智能语音识别应用，曾获一个奖项。',
    tech: ['Vue', 'TypeScript', 'Vite'],
    link: 'https://github.com/Wanfeng1028/ParrotSoundReVue',
    accent: '#6366f1'
  },
  {
    type: 'project',
    title: 'BlogAstroPure',
    description: '基于 Astro 的个人博客，当前本站。',
    tech: ['Astro', 'TypeScript', 'Tailwind'],
    link: 'https://github.com/Wanfeng1028/BlogAstroPure',
    accent: '#f97316'
  },
  {
    type: 'project',
    title: 'GeoFrontend2.0',
    description: 'GIS 工作台前端，聚焦遥感智能识别与可视化。',
    tech: ['GIS', 'JavaScript', 'Vue'],
    link: 'https://github.com/Wanfeng1028/GeoFrontend2.0',
    accent: '#10b981'
  },
  // ===== Certificates =====
  {
    type: 'certificate',
    title: '示例：前端开发工程师认证',
    issuer: '示例机构 / 颁发方',
    year: 2026,
    description: '占位示例，请替换为你的真实证书名称、颁发机构与链接。',
    link: '#'
  },
  // ===== Publications =====
  {
    type: 'publication',
    title: '示例：遥感影像语义分割方法研究',
    authors: ['Wanfeng', 'Coauthor'],
    venue: '示例期刊 / 会议',
    year: 2026,
    description: '占位示例，请替换为你的真实论文、作者与链接。',
    link: '#'
  },
  {
    type: 'publication',
    title: '示例：基于深度学习的作物识别综述',
    authors: ['Wanfeng'],
    venue: '示例会议',
    year: 2025,
    description: '占位示例，请替换为你的真实论文、作者与链接。',
    link: '#'
  }
]

const projectCount = items.filter((i) => i.type === 'project').length
const certificateCount = items.filter((i) => i.type === 'certificate').length
const publicationCount = items.filter((i) => i.type === 'publication').length
---

<PageLayout title='Projects & Publications' hideSidebar view>
  <div class='pub-page'>
    {/* 居中分段切换按钮（滑块动效） */}
    <div class='pub-toggle' id='pub-toggle' role='tablist' aria-label='筛选展示内容'>
      <span class='pub-toggle__indicator' id='pub-indicator' aria-hidden='true'></span>
      <button class='pub-toggle__btn is-active' data-filter='all' role='tab' aria-selected='true'>
        全部 <span class='pub-toggle__count'>{items.length}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='project' role='tab' aria-selected='false'>
        Projects <span class='pub-toggle__count'>{projectCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='certificate' role='tab' aria-selected='false'>
        Certificates <span class='pub-toggle__count'>{certificateCount}</span>
      </button>
      <button class='pub-toggle__btn' data-filter='publication' role='tab' aria-selected='false'>
        Publications <span class='pub-toggle__count'>{publicationCount}</span>
      </button>
    </div>

    {/* 内容区 */}
    <div id='pub-content' class='pub-content'>
      {
        items.map((item, i) =>
          item.type === 'project' ? (
            <article class='repo-card tilt-card' data-tilt='' data-type='project' style={`--accent: ${item.accent}`}>
              <div class='repo-card__top'>
                <span class='repo-card__dot' aria-hidden='true'></span>
                <a
                  href={item.link}
                  target='_blank'
                  rel='noopener'
                  class='repo-card__link'
                  title='查看仓库'
                  aria-label={`查看 ${item.title}`}
                >
                  <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 17 17 7' /><path d='M7 7h10v10' /></svg>
                </a>
              </div>
              <h3 class='repo-card__title'>{item.title}</h3>
              <p class='repo-card__desc'>{item.description}</p>
              <div class='repo-card__tags'>
                {item.tech.map((t) => <span class='repo-card__tag'>{t}</span>)}
              </div>
            </article>
          ) : item.type === 'certificate' ? (
            <article class='cert-card' data-type='certificate'>
              <div class='cert-card__badge' aria-hidden='true'>
                <svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='8' r='6' /><path d='M15.5 12.5 17 22l-5-3-5 3 1.5-9.5' /></svg>
              </div>
              <div class='cert-card__body'>
                <h3 class='cert-card__title'>
                  <a href={item.link} target='_blank' rel='noopener'>{item.title}</a>
                </h3>
                <p class='cert-card__meta'>
                  <span class='cert-card__issuer'>{item.issuer}</span>
                  <span class='cert-card__year'>{item.year}</span>
                </p>
                <p class='cert-card__desc'>{item.description}</p>
              </div>
              <a
                href={item.link}
                target='_blank'
                rel='noopener'
                class='cert-card__link'
                title='查看证书'
                aria-label={`查看 ${item.title}`}
              >
                <svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 17 17 7' /><path d='M7 7h10v10' /></svg>
              </a>
            </article>
          ) : (
            <article class='pub-item' data-type='publication'>
              <span class='pub-item__num'>{String(i + 1).padStart(2, '0')}</span>
              <div class='pub-item__body'>
                <h3 class='pub-item__title'>
                  <a href={item.link} target='_blank' rel='noopener'>{item.title}</a>
                </h3>
                <p class='pub-item__meta'>
                  <span class='pub-item__authors'>{item.authors.join(', ')}</span>
                  <span class='pub-item__venue'>{item.venue}</span>
                  <span class='pub-item__year'>{item.year}</span>
                </p>
                <p class='pub-item__desc'>{item.description}</p>
              </div>
              <a
                href={item.link}
                target='_blank'
                rel='noopener'
                class='pub-item__link'
                title='查看'
                aria-label={`查看 ${item.title}`}
              >
                <svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 17 17 7' /><path d='M7 7h10v10' /></svg>
              </a>
            </article>
          )
        )
      }
    </div>
  </div>
</PageLayout>

<script>
  import { initTilt } from '@/utils/tilt'

  const toggle = document.getElementById('pub-toggle')
  const buttons = toggle?.querySelectorAll<HTMLElement>('.pub-toggle__btn')
  const indicator = document.getElementById('pub-indicator')
  const items = document.querySelectorAll<HTMLElement>('#pub-content [data-type]')

  // 滑块移动到对应按钮
  function moveIndicator(btn: Element | undefined) {
    if (!indicator || !btn) return
    const el = btn as HTMLElement
    indicator.style.left = `${el.offsetLeft}px`
    indicator.style.width = `${el.offsetWidth}px`
  }

  function onSelect(btn: HTMLElement) {
    buttons?.forEach((b) => {
      b.classList.toggle('is-active', b === btn)
      b.setAttribute('aria-selected', b === btn ? 'true' : 'false')
    })
    moveIndicator(btn)
    const filter = btn.dataset.filter
    items.forEach((item) => {
      const show = filter === 'all' || item.dataset.type === filter
      item.classList.toggle('is-hidden', !show)
    })
  }

  buttons?.forEach((btn) => btn.addEventListener('click', () => onSelect(btn)))

  // 初始定位 + 窗口尺寸变化时重新定位
  window.addEventListener('load', () => moveIndicator(buttons?.[0]))
  window.addEventListener('resize', () => {
    const active = buttons?.[0]?.parentElement?.querySelector('.is-active') ?? buttons?.[0]
    moveIndicator(active)
  })

  // 3D Tilt 反光卡片交互（项目卡片）
  initTilt('.repo-card[data-tilt]')
</script>

<style>
  .pub-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 分段切换按钮 —— Gemini 官方最终版（全部官方真实值） */
  /* 容器 */
  .pub-toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px; /* 官方：3px */
    border: 1px solid #e5e5e5; /* 官方：--theme-border-color */
    border-radius: 100px; /* 官方：100px */
    background: #ffffff;
    box-shadow: none; /* 官方：无投影 */
    margin-bottom: 2rem;
    font-family: 'Google Sans', Roboto, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  /* 滑动指示条：官方渐变胶囊，随激活项滑动 */
  .pub-toggle__indicator {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    border-radius: 100px;
    background: linear-gradient(89.58deg, #3186ff 0.28%, #346bf0 44.45%, #4ea0ff 99.55%);
    transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1), width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  /* 按钮 */
  .pub-toggle .pub-toggle__btn {
    position: relative;
    z-index: 1;
    appearance: none;
    border: none;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 18px; /* 官方：18px */
    font-weight: 500;
    line-height: 1.4; /* 官方：1.4 */
    color: #5f6368; /* 官方：--theme-text-color-secondary */
    padding: 12px 24px; /* 官方：12px 24px */
    border-radius: 100px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px; /* 官方：gap 10px */
    transition: color 0.3s ease, background 0.3s ease;
  }
  .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: #f4f4f5;
  }

  /* 激活态：文字白、背景透明，由下方滑块提供官方渐变填充 */
  .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }

  /* 角标（自己的扩展，官方没有） */
  .pub-toggle .pub-toggle__count {
    font-size: 0.78rem;
    font-weight: 500;
    background: transparent;
    opacity: 0.55;
  }
  .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
    opacity: 0.9;
    color: #fff;
  }

  /* 暗色模式 */
  .dark .pub-toggle {
    background: #1f2128;
    border-color: #3a3d45;
  }
  .dark .pub-toggle .pub-toggle__btn {
    color: #9aa0a6;
  }
  .dark .pub-toggle .pub-toggle__btn:hover:not(.is-active) {
    background: rgba(255, 255, 255, 0.08);
  }
  .dark .pub-toggle .pub-toggle__btn.is-active {
    color: #ffffff;
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__count,
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    background: transparent;
  }
  .dark .pub-toggle .pub-toggle__btn.is-active .pub-toggle__count {
    color: #fff;
  }

  /* 内容区 */
  .pub-content {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* 项目卡片 */
  .repo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.3rem 1.25rem;
    border-radius: calc(var(--radius) * 1.25);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, hsl(var(--border)));
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, transparent), transparent 55%),
      hsl(var(--card));
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  /* 顶部品牌色渐变条 */
  .repo-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 30%, transparent));
    opacity: 1;
  }
  .repo-card:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: 0 16px 32px -16px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .repo-card__top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .repo-card__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .repo-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    margin-right: -0.4rem;
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    transition: background 0.2s ease, color 0.2s ease;
  }
  .repo-card__link:hover {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .repo-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    transition: color 0.2s ease;
  }
  .repo-card:hover .repo-card__title {
    color: var(--accent);
  }
  .repo-card__desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }
  .repo-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }
  .repo-card__tag {
    font-size: 0.75rem;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: color-mix(in srgb, var(--accent) 85%, hsl(var(--foreground)));
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
  }

  /* 证书卡片 */
  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    border-radius: calc(var(--radius) * 1.25);
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .cert-card:hover {
    transform: translateY(-3px);
    border-color: hsl(var(--primary) / 0.5);
    box-shadow: 0 12px 28px -14px hsl(var(--primary) / 0.35);
  }
  .cert-card__badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
  }
  .cert-card__body {
    flex: 1;
    min-width: 0;
  }
  .cert-card__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--foreground));
  }
  .cert-card__title a {
    color: inherit;
    transition: color 0.2s ease;
  }
  .cert-card__title a:hover {
    color: hsl(var(--primary));
  }
  .cert-card__meta {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cert-card__issuer {
    color: hsl(var(--foreground));
  }
  .cert-card__year {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
  }
  .cert-card__desc {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
  }
  .cert-card__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    margin-left: auto;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .cert-card__link:hover {
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  /* 出版物条目（学术列表样式） */
  .pub-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    border-radius: calc(var(--radius) * 1.25);
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .pub-item:hover {
    background: hsl(var(--muted) / 0.5);
    border-color: hsl(var(--border));
  }
  .pub-item__num {
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--primary));
    padding-top: 0.15rem;
  }
  .pub-item__body {
    flex: 1;
    min-width: 0;
  }
  .pub-item__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--foreground));
  }
  .pub-item__title a {
    color: inherit;
    transition: color 0.2s ease;
  }
  .pub-item__title a:hover {
    color: hsl(var(--primary));
  }
  .pub-item__meta {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .pub-item__authors {
    color: hsl(var(--foreground));
  }
  .pub-item__meta .pub-item__venue {
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
  .pub-item__year {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
  }
  .pub-item__desc {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
  }
  .pub-item__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    margin-left: auto;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .pub-item__link:hover {
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  /* 筛选隐藏 */
  .pub-content .is-hidden {
    display: none;
  }

  /* 桌面端双列 */
  @media (min-width: 640px) {
    .pub-content {
      grid-template-columns: 1fr 1fr;
    }
    .pub-item[data-type='publication'],
    .cert-card[data-type='certificate'] {
      grid-column: 1 / -1;
    }
  }
</style>