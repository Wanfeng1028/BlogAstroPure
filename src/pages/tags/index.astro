---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import EmptyState from '@/components/common/EmptyState.astro'

const blogPosts = await getBlogCollection()
const murmurPosts = await getBlogCollection('murmurs')
const allTags = getUniqueTagsWithCount([...blogPosts, ...murmurPosts]).sort(
  (a, b) => b[1] - a[1]
)
const totalTags = allTags.length
const maxCount = Math.max(...allTags.map(([, c]) => c), 1)

const meta = {
  description: '这里汇总了我写过的所有话题标签',
  title: 'Tags'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate mb-8'>
      <h1 class='text-3xl font-medium'>Tags</h1>
      <p class='mt-2 text-muted-foreground'>共 {totalTags} 个标签</p>
    </div>

    <div id='content' class='animate'>
      {
        allTags.length > 0 ? (
          <div class='tag-cloud'>
            {
              allTags.map(([tag, val]) => {
                const ratio = val / maxCount
                const size = (0.9 + ratio * 0.9).toFixed(3)
                const opacity = 0.55 + ratio * 0.45
                return (
                  <a
                    href={`/tags/${tag}`}
                    data-astro-prefetch
                    class='tag-cloud__item'
                    style={`font-size: ${size}rem; opacity: ${opacity}`}
                  >
                    <span class='tag-cloud__hash'>#</span>
                    {tag}
                    <span class='tag-cloud__count'>{val}</span>
                  </a>
                )
              })
            }
          </div>
        ) : (
          <EmptyState title='暂无标签' hint='标签信息正在整理中，敬请期待' />
        )
      }
    </div>
  </main>
</PageLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 2.5rem 1.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) * 1.5);
    background: linear-gradient(180deg, hsl(var(--card)) 0%, hsl(var(--background)) 100%);
    box-shadow:
      0 1px 2px 0 rgba(0, 0, 0, 0.04),
      0 8px 24px -12px rgba(0, 0, 0, 0.12);
  }
  .tag-cloud__item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition:
      transform 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .tag-cloud__item:hover {
    transform: translateY(-2px) scale(1.05);
    color: hsl(var(--primary));
    background-color: hsl(var(--muted) / 0.5);
    box-shadow: 0 4px 12px -4px hsl(var(--primary) / 0.35);
  }
  .tag-cloud__hash {
    font-weight: 600;
    color: hsl(var(--primary));
  }
  .tag-cloud__count {
    font-size: 0.7em;
    line-height: 1;
    padding: 0.25em 0.55em;
    border-radius: 999px;
    background-color: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
  }
</style>
