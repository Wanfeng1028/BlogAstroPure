---
import { getBlogCollection } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import CatTree from '@/components/CatTree.astro'

interface CatNode {
  name: string
  path: string
  own: number
  total: number
  children: CatNode[]
}

const allPosts = await getBlogCollection()

// 统计每个完整分类路径的文章数
const counts = new Map<string, number>()
for (const post of allPosts) {
  const cat = 'category' in post.data ? (post.data.category as string | undefined) : undefined
  if (cat) counts.set(cat, (counts.get(cat) || 0) + 1)
}

// 按斜杠分层构建树
const root: CatNode[] = []
const nodeMap = new Map<string, CatNode>()
for (const [path, count] of counts) {
  const parts = path.split('/')
  let siblings = root
  let acc = ''
  for (const part of parts) {
    acc = acc ? `${acc}/${part}` : part
    let node = nodeMap.get(acc)
    if (!node) {
      node = { name: part, path: acc, own: 0, total: 0, children: [] }
      nodeMap.set(acc, node)
      siblings.push(node)
    }
    node.own += count
    siblings = node.children
  }
}

// 递归计算 total（自身 + 所有后代）
function computeTotal(nodes: CatNode[]): number {
  let sum = 0
  for (const n of nodes) {
    n.total = n.own + computeTotal(n.children)
    n.children.sort((a, b) => b.total - a.total)
    sum += n.total
  }
  return sum
}
computeTotal(root)
root.sort((a, b) => b.total - a.total)

const totalCategories = nodeMap.size

const meta = {
  description: '这里汇总了我写过的所有文章分类',
  title: '全部分类'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate mb-8'>
      <h1 class='text-3xl font-medium'>分类</h1>
      <p class='mt-2 text-muted-foreground'>共 {totalCategories} 个分类</p>
    </div>

    <div id='content' class='animate'>
      {
        root.length > 0 ? (
          <CatTree nodes={root} />
        ) : (
          <p class='text-muted-foreground'>暂无分类</p>
        )
      }
    </div>
  </main>
</PageLayout>
