---
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import CatTree from '@/components/CatTree.astro'
import EmptyState from '@/components/common/EmptyState.astro'

type Post = CollectionEntry<'blog'>

interface CatNode {
  name: string
  path: string
  own: number
  total: number
  children: CatNode[]
  posts: Post[]
}

const allPosts = (await getBlogCollection()) as Post[]

// 统计每个完整分类路径的文章数
const counts = new Map<string, number>()
const postsByCat = new Map<string, Post[]>()
for (const post of allPosts) {
  const cat = 'category' in post.data ? (post.data.category as string | undefined) : undefined
  if (!cat) continue
  counts.set(cat, (counts.get(cat) || 0) + 1)
  if (!postsByCat.has(cat)) postsByCat.set(cat, [])
  postsByCat.get(cat)!.push(post)
}

// 按斜杠分层构建树
const root: CatNode[] = []
const nodeMap = new Map<string, CatNode>()
for (const [path, count] of counts) {
  const parts = path.split('/')
  let siblings = root
  let acc = ''
  for (const part of parts) {
    acc = acc ? `${acc}/${part}` : part
    let node = nodeMap.get(acc)
    if (!node) {
      node = { name: part, path: acc, own: 0, total: 0, children: [], posts: [] }
      nodeMap.set(acc, node)
      siblings.push(node)
    }
    node.own += count
    siblings = node.children
  }
}

// 把文章挂到对应分类节点（按日期倒序）
function attachPosts(nodes: CatNode[]): void {
  for (const n of nodes) {
    n.posts = sortMDByDate(postsByCat.get(n.path) ?? []) as Post[]
    attachPosts(n.children)
  }
}

// 递归计算 total（自身 + 所有后代）
function computeTotal(nodes: CatNode[]): number {
  let sum = 0
  for (const n of nodes) {
    n.total = n.own + computeTotal(n.children)
    n.children.sort((a, b) => b.total - a.total)
    sum += n.total
  }
  return sum
}
attachPosts(root)
computeTotal(root)
root.sort((a, b) => b.total - a.total)

const totalCategories = nodeMap.size

const meta = {
  description: '这里汇总了我写过的所有文章分类',
  title: 'Categories'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate mb-8'>
      <h1 class='text-3xl font-medium'>Categories</h1>
      <p class='mt-2 text-muted-foreground'>共 {totalCategories} 个分类</p>
    </div>

    <div id='content' class='animate'>
      {
        root.length > 0 ? (
          <CatTree nodes={root} />
        ) : (
          <EmptyState title='暂无分类' hint='分类信息正在整理中，敬请期待' />
        )
      }
    </div>
  </main>
</PageLayout>

<script>
  // 分类树：点击箭头按钮展开/收起子级（子分类 + 文章）
  document.querySelectorAll('[data-cat-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.cat-tree__item')
      if (!item) return
      const collapsed = item.classList.toggle('cat-tree__item--collapsed')
      btn.setAttribute('aria-expanded', String(!collapsed))
    })
  })
</script>
