---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = (await getBlogCollection()) as CollectionEntry<'blog'>[]
  const paths = new Set<string>()
  for (const post of posts) {
    const cat = 'category' in post.data ? (post.data.category as string | undefined) : undefined
    if (!cat) continue
    // 加入自身及所有祖先路径，确保父级分类页也生成
    const parts = cat.split('/')
    let acc = ''
    for (const part of parts) {
      acc = acc ? `${acc}/${part}` : part
      paths.add(acc)
    }
  }
  return [...paths].map((category) => ({ params: { category } }))
}

const { category } = Astro.params

const allPosts = (await getBlogCollection()) as CollectionEntry<'blog'>[]
const posts = sortMDByDate(
  allPosts.filter((post) => {
    const cat = 'category' in post.data ? (post.data.category as string | undefined) : undefined
    // 匹配自身及所有子分类
    return cat === category || (cat?.startsWith(`${category}/`) ?? false)
  })
)

const displayName = category?.split('/').pop() ?? ''

const meta = {
  description: `查看分类「${displayName}」下的所有文章`,
  title: `Category: ${displayName}`
}
---

<PageLayout {meta}>
  <Button title='Back' href='/categories' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 flex items-end gap-x-2 text-3xl font-medium'>
        Category:
        <span class='text-2xl'>{displayName}</span>
        <span class='text-base text-muted-foreground'>共 {posts.length} 篇</span>
      </h1>
    </div>

    <section id='content' class='animate' aria-label='Blog post list'>
      {
        posts.length > 0 ? (
          <ul class='flex flex-col gap-y-3 text-start'>
            {posts.map((post) => <PostPreview {post} detailed />)}
          </ul>
        ) : (
          <p class='text-muted-foreground'>暂无文章</p>
        )
      }
    </section>
  </main>
</PageLayout>
