---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection('murmurs'))
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'murmurs'>>
  collectionsCount: number
}

const { page, collectionsCount } = Astro.props

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})

const meta = {
  description: '一些随想和碎碎念',
  title: 'Murmurs'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← 上一页`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `下一页 →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate mb-8'>
      <h1 class='text-3xl font-medium'>Murmurs</h1>
      <p class='mt-2 text-muted-foreground'>共 {collectionsCount} 条随想</p>
    </div>

    {
      page.data.length === 0 ? (
        <p class='text-muted-foreground'>暂无内容。</p>
      ) : (
        <section aria-label='碎碎念列表' class='animate' id='content'>
          <div class='murmur-feed'>
            {
              page.data.map((post) => (
                <div class='murmur-feed__item'>
                  <div class='murmur-feed__head'>
                    <a
                      href={`/murmurs/${post.id}`}
                      class='murmur-feed__title'
                      data-astro-prefetch
                    >
                      {post.data.title}
                    </a>
                    <time class='murmur-feed__date'>{dateFmt.format(post.data.publishDate)}</time>
                  </div>
                  <p class='murmur-feed__text'>{post.body}</p>
                  {
                    post.data.tags.length > 0 && (
                      <ul class='murmur-feed__tags'>
                        {post.data.tags.map((tag) => (
                          <li>
                            <a
                              href={`/tags/${tag}`}
                              class='murmur-feed__tag'
                              data-astro-prefetch
                            >
                              <span class='murmur-feed__hash'>#</span>{tag}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </div>
              ))
            }
          </div>

          <Paginator {...paginationProps} />
        </section>
      )
    }
  </main>
</PageLayout>

<style>
  .murmur-feed {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 2.5rem 1.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: calc(var(--radius) * 1.5);
    background: linear-gradient(180deg, hsl(var(--card)) 0%, hsl(var(--background)) 100%);
    box-shadow:
      0 1px 2px 0 rgba(0, 0, 0, 0.04),
      0 8px 24px -12px rgba(0, 0, 0, 0.12);
  }

  .murmur-feed__item {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid hsl(var(--border) / 0.5);
    transition: background-color 0.2s ease;
  }
  .murmur-feed__item:first-child {
    padding-top: 0;
  }
  .murmur-feed__item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }
  .murmur-feed__item:hover {
    background-color: hsl(var(--muted) / 0.3);
    border-radius: 8px;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin-left: -0.75rem;
    margin-right: -0.75rem;
  }

  .murmur-feed__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .murmur-feed__title {
    font-size: 1.1rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    transition: color 0.2s ease;
  }
  .murmur-feed__item:hover .murmur-feed__title {
    color: hsl(var(--primary));
  }
  .murmur-feed__date {
    flex-shrink: 0;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }

  .murmur-feed__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.75;
    color: hsl(var(--foreground) / 0.85);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .murmur-feed__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0 0;
    padding: 0;
  }
  .murmur-feed__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.85rem;
    color: hsl(var(--foreground) / 0.7);
    text-decoration: none;
    background-color: hsl(var(--muted) / 0.5);
    transition:
      transform 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .murmur-feed__tag:hover {
    transform: translateY(-1px) scale(1.05);
    color: hsl(var(--primary));
    background-color: hsl(var(--muted) / 0.8);
  }
  .murmur-feed__hash {
    font-weight: 600;
    color: hsl(var(--primary));
  }

  @media (max-width: 480px) {
    .murmur-feed {
      padding: 1.5rem 1rem;
    }
    .murmur-feed__head {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
