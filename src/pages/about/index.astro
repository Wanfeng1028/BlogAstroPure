---
import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProfileLinks from '@/components/home/ProfileLinks.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'journey', text: 'Internship/Work Experience' },
  { depth: 2, slug: 'hobbies', text: 'Hobbies & Interests' },
  { depth: 2, slug: 'certifications', text: 'Certifications' }
]

const journeyEvents = [
  { date: '2026.02-2026.06', content: '浙江建投数字技术有限公司 · 前端开发实习生' },
]
---

<PageLayout title='About' {headings} view>
  {/* about-me */}
  <section id='about-me'>
    <div class='flex flex-col items-center not-prose text-center'>
      <div class='avatar-ring-wrap'>
        <div class='avatar-ring'></div>
        <div class='avatar-ring-glow'></div>
        <img
          src='/images/touxiang.png'
          alt='晚风'
          class='size-24 rounded-full object-contain bg-muted p-1'
        />
      </div>
      <h2 class='mt-3 mb-1 text-2xl font-medium'>晚风</h2>
      <p class='text-muted-foreground'>开发者</p>
      <ProfileLinks />
    </div>

    <p class='mt-4 text-center text-sm italic text-muted-foreground'>
      每个优秀的人都有一段沉默的时光，那段时光是付出了很多努力，却得不到结果的日子，我们把它叫做扎根。
    </p>

    <h3 class='mt-8 mb-3 text-2xl font-bold'>Infomation</h3>
    <p>
      2022 级地理信息科学专业，2026 届本科毕业生，目前二学位在读（考研ing）。
    </p>
    <p>
      本科期间的主要方向:GIS 开发，全栈开发（ing）;
      本科期间主要关注遥感智能识别、遥感图像处理、深度学习等相关的研究;
      目前主要在学习以Go技术栈为主的后端开发和Agent开发。
    </p>
    <p>
      写这个博客主要是为了记录日常的学习和生活，希望在技术之路上留下一些痕迹。
    </p>
    <p class='text-sm text-muted-foreground'>
      联系我：
      <a href='mailto:wanfeng572@gmail.com' class='text-primary hover:underline'>wanfeng572@gmail.com</a>
    </p>
  </section>

  {/* education */}
  <h2 id='education' class='mt-10'>Education</h2>
  <div class='not-prose mt-4 rounded-xl bg-muted/60 p-5'>
    <p class='text-base font-semibold'>地理信息科学（本科）</p>
    <p class='mt-1 text-sm text-muted-foreground'>GIS 开发、遥感智能识别、计算机视觉</p>
    <p class='mt-2 text-xs text-muted-foreground'>2022.09 – 2026.06</p>
  </div>,
    <div class='not-prose mt-4 rounded-xl bg-muted/60 p-5'>
    <p class='text-base font-semibold'>数据科学与大数据技术（第二学士学位）</p>
    <p class='mt-1 text-sm text-muted-foreground'>考研ing</p>
    <p class='mt-2 text-xs text-muted-foreground'>2026.09 – 2027.06</p>
  </div>

  {/* journey */}
  <h2 id='journey' class='mt-10'>Internship/Work Experience</h2>
  <Timeline events={journeyEvents} />

  {/* hobbies */}
  <h2 id='hobbies' class='mt-10'>Hobbies & Interests</h2>
  <ul>
    <li>📷 摄影（想学）</li>
    <li>🎸 会弹点吉他，希望之后可以把吉他重新捡起来</li>
    <li>🏀 偶尔打篮球，但大三之后没体育课就很少运动了</li>
  </ul>

  {/* certifications */}
  <h2 id='certifications' class='mt-10'>Certifications</h2>
  <div class='not-prose mt-4 rounded-xl bg-muted/60 p-5'>
    <p class='text-base font-semibold'>一些证书</p>
    <p class='mt-1 text-sm text-muted-foreground'>
      <strong>2024-2025浙江省政府奖学金</strong><br>
      <strong>2025-2026浙江省政府奖学金</strong><br>
      <strong>And so on...(本科期间的证书之后整理一下hhh)</strong><br>
    </p>
  </div>

  {/* skillicons */}
  <div class='not-prose mt-10'>
    <img
      src='https://skillicons.dev/icons?i=vue,react,angular,go,java,nodejs,ts,js,docker,git,linux,vscode&theme=light'
      alt='Tech Stack'
      class='max-w-full'
      loading='lazy'
    />
  </div>
</PageLayout>
