---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: '关于我' },
  { depth: 2, slug: 'journey', text: '经历' },
  { depth: 2, slug: 'hobbies', text: '兴趣爱好' },
  { depth: 2, slug: 'tools', text: '工具与技术栈' },
  { depth: 2, slug: 'social', text: '社交账号' },
  { depth: 2, slug: 'projects', text: '开源项目' },
  { depth: 2, slug: 'gossips', text: '碎碎念' }
]

const journeyEvents = [
  { date: '2022', content: '进入<strong>杭州师范大学</strong>，地理信息科学专业（GIS 开发、遥感智能识别、计算机视觉）' },
  { date: '2026.02', content: '浙江建投数字技术有限公司 · 前端开发实习' },
  { date: '2026.06', content: '本科毕业，开始二学位（数据科学与大数据技术）+ 考研' },
  { date: '现在', content: '学习 Go 后端 & Agent 方向' }
]
