---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: '关于我' },
  { depth: 2, slug: 'education', text: '教育背景' },
  { depth: 2, slug: 'experience', text: '工作经历' },
  { depth: 2, slug: 'hobbies', text: '兴趣爱好' },
  { depth: 2, slug: 'tools', text: '工具与技术栈' },
  { depth: 2, slug: 'social', text: '社交账号' },
  { depth: 2, slug: 'projects', text: '开源项目' },
  { depth: 2, slug: 'gossips', text: '碎碎念' }
]
---

<PageLayout title='关于' {headings} comment>
  {/* about-me */}
  <section id='about-me'>
    <div class='flex items-center gap-4 not-prose'>
      <img
        src='/src/assets/touxiang.png'
        alt='晚风'
        class='size-20 rounded-full border object-cover'
      />
      <div>
        <h2 class='mb-1 text-2xl font-medium'>晚风</h2>
        <p class='text-muted-foreground'>前端工程师 · 全栈开发者 · 学生</p>
        <p class='mt-1 text-sm text-primary'>每个优秀的人都有一段沉默的时光，那段时光是付出了很多努力，却得不到结果的日子，我们把它叫做扎根。</p>
      </div>
    </div>

    <h3 class='mt-8 mb-3 text-lg font-medium'>个人简介</h3>
    <p>
      我是晚风，杭州师范大学 2022 级地理信息科学专业，2026 届毕业生，目前二学位在读（考研ing）。
    </p>
    <p>
      专业方向是 GIS 开发，本科期间做过遥感智能识别、计算机视觉相关的研究。毕业前在浙江建投数字技术有限公司做过前端开发实习。目前在学习 Agent 相关的方向，同时对 Go 后端开发很感兴趣。
    </p>
    <p>
      写这个博客主要是为了记录日常的学习和生活，希望在技术之路上留下一些痕迹。
    </p>
    <p class='text-sm text-muted-foreground'>
      联系我：
      <a href='mailto:wanfeng572@gmail.com' class='text-primary hover:underline'>wanfeng572@gmail.com</a>
      <span class='mx-1'>·</span>
      微信：【TODO: 填微信号】
    </p>
  </section>

  {/* education */}
