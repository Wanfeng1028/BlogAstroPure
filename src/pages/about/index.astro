---
import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProfileLinks from '@/components/home/ProfileLinks.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'journey', text: 'Internship/Work Experience' },
  { depth: 2, slug: 'hobbies', text: 'Hobbies & Interests' },
  { depth: 2, slug: 'certifications', text: 'Certifications' }
]

// Timeline content 用带 lang 类的 HTML 字符串（Timeline 会按 HTML 渲染）
const tZh = (zh: string, en: string) =>
  `<span class='lang-zh'>${zh}</span><span class='lang-en'>${en}</span>`

const journeyEvents = [
  {
    date: '2026.02-2026.06',
    content: tZh(
      '浙江建投数字技术有限公司 · 前端开发实习生',
      'Zhejiang Construction Investment Digital Technology Co., Ltd. · Frontend Development Intern'
    )
  }
]

// Skills 分类（icons 为 skillicons.dev 图标名，逗号分隔）
const skills = [
  { title: 'OS', icons: 'apple,linux,windows,ubuntu,debian,arch' },
  {
    title: 'Language & Frameworks',
    icons: 'ts,js,go,python,java,vue,react,angular,astro,vite,nodejs,gin'
  },
  { title: 'Tool', icons: 'docker,postgres,git,vscode' }
]
---

<PageLayout title='About' {headings} view>
  {/* 中英文切换（gemini-btn 风格） */}
  <div class='mb-6 flex justify-end'>
    <button
      id='about-lang-toggle'
      type='button'
      class='gemini-btn inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium text-white'
      aria-label='Toggle language'
    >
      <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='h-4 w-4'><path d='m5 8 6 6'/><path d='m4 14 6-6 2-3'/><path d='M2 5h12'/><path d='M7 2h1'/><path d='m22 22-5-10-5 10'/><path d='M14 18h6'/></svg>
      <span class='lang-toggle-label'><span class='lang-zh'>English</span><span class='lang-en'>中文</span></span>
    </button>
  </div>

  {/* about-me */}
  <section id='about-me'>
    <div class='flex flex-col items-center not-prose text-center'>
      <div class='avatar-ring-wrap'>
        <div class='avatar-ring'></div>
        <div class='avatar-ring-glow'></div>
        <img
          src='/images/touxiang.png'
          alt='晚风 / Wanfeng'
          class='size-24 rounded-full object-contain bg-muted p-1'
        />
      </div>
      <h2 class='mt-3 mb-1 text-2xl font-medium'>
        <span class='lang-zh'>晚风</span>
        <span class='lang-en'>Wanfeng</span>
      </h2>
      <p class='text-muted-foreground'>
        <span class='lang-zh'>开发者</span>
        <span class='lang-en'>Developer</span>
      </p>
      <ProfileLinks />
    </div>

    <p class='mt-4 text-center text-sm italic text-muted-foreground'>
      <span class='lang-zh'>每个优秀的人都有一段沉默的时光，那段时光是付出了很多努力，却得不到结果的日子，我们把它叫做扎根。</span>
      <span class='lang-en'>Every outstanding person has a period of silence — days when great efforts yield no visible results. We call this "taking root."</span>
    </p>

    <h3 class='mt-8 mb-3 text-2xl font-bold'>Infomation</h3>
    <p>
      <span class='lang-zh'>2022 级地理信息科学专业，2026 届本科毕业生，目前二学位在读（考研ing）。</span>
      <span class='lang-en'>Class of 2022, Geographic Information Science. Expected 2026 bachelor's graduate. Currently enrolled in a second bachelor's degree program (preparing for postgraduate entrance exams).</span>
    </p>
    <p>
      <span class='lang-zh'>本科期间的主要方向：GIS 开发，全栈开发（ing）；本科期间主要关注遥感智能识别、遥感图像处理、深度学习等相关的研究；目前主要在学习以 Go 技术栈为主的后端开发和 Agent 开发。</span>
      <span class='lang-en'>Main focus during undergraduate studies: GIS development, full-stack development (in progress). Research interests: intelligent remote sensing recognition, remote sensing image processing, and deep learning. Currently focused on Go-based backend development and Agent development.</span>
    </p>
    <p>
      <span class='lang-zh'>写这个博客主要是为了记录日常的学习和生活，希望在技术之路上留下一些痕迹。</span>
      <span class='lang-en'>I created this blog to document my daily learning and life experiences, and to leave behind some traces along my technology journey.</span>
    </p>
    <p class='text-sm text-muted-foreground'>
      <span class='lang-zh'>联系我：</span>
      <span class='lang-en'>Contact me: </span>
      <a href='mailto:wanfeng572@gmail.com' class='text-primary hover:underline'>wanfeng572@gmail.com</a>
    </p>
  </section>

  {/* education */}
  <h2 id='education' class='mt-10'>Education</h2>
  <div class='not-prose mt-4 rounded-xl bg-muted/60 p-5'>
    <p class='text-base font-semibold'>
      <span class='lang-zh'>地理信息科学（本科）</span>
      <span class='lang-en'>Geographic Information Science (Bachelor's)</span>
    </p>
    <p class='mt-1 text-sm text-muted-foreground'>
      <span class='lang-zh'>GIS 开发、遥感智能识别、计算机视觉</span>
      <span class='lang-en'>GIS Development · Intelligent Remote Sensing Recognition · Computer Vision</span>
    </p>
    <p class='mt-2 text-xs text-muted-foreground'>2022.09 – 2026.06</p>
  </div>
  <div class='not-prose mt-4 rounded-xl bg-muted/60 p-5'>
    <p class='text-base font-semibold'>
      <span class='lang-zh'>数据科学与大数据技术（第二学士学位）</span>
      <span class='lang-en'>Data Science and Big Data Technology (Second Bachelor's Degree)</span>
    </p>
    <p class='mt-1 text-sm text-muted-foreground'>
      <span class='lang-zh'>考研ing</span>
      <span class='lang-en'>Preparing for Postgraduate Entrance Exams</span>
    </p>
    <p class='mt-2 text-xs text-muted-foreground'>2026.09 – 2027.06</p>
  </div>

  {/* journey */}
  <h2 id='journey' class='mt-10'>Internship/Work Experience</h2>
  <Timeline events={journeyEvents} />

  {/* hobbies */}
  <h2 id='hobbies' class='mt-10'>Hobbies & Interests</h2>
  <ul>
    <li>
      📷
      <span class='lang-zh'> 摄影（想学）</span>
      <span class='lang-en'> Photography (Want to Learn)</span>
    </li>
    <li>
      🎸
      <span class='lang-zh'> 会弹点吉他，希望之后可以把吉他重新捡起来</span>
      <span class='lang-en'> Play a bit of guitar — hoping to pick it back up again</span>
    </li>
    <li>
      🏀
      <span class='lang-zh'> 偶尔打篮球，但大三之后没体育课就很少运动了</span>
      <span class='lang-en'> Occasionally play basketball; haven't exercised much since PE classes stopped after junior year</span>
    </li>
  </ul>

  {/* certifications */}
  <h2 id='certifications' class='mt-10'>Certifications</h2>
  <div class='not-prose mt-4 rounded-xl bg-muted/60 p-5'>
    <p class='text-base font-semibold'>
      <span class='lang-zh'>一些证书</span>
      <span class='lang-en'>Some Certificates</span>
    </p>
    <p class='mt-1 text-sm text-muted-foreground'>
      <strong>
        <span class='lang-zh'>2024–2025 浙江省政府奖学金</span>
        <span class='lang-en'>2024–2025 Zhejiang Provincial Government Scholarship</span>
      </strong><br>
      <strong>
        <span class='lang-zh'>2025–2026 浙江省政府奖学金</span>
        <span class='lang-en'>2025–2026 Zhejiang Provincial Government Scholarship</span>
      </strong><br>
      <strong>
        <span class='lang-zh'>And so on...（本科期间的证书之后整理一下 hhh）</span>
        <span class='lang-en'>And so on... (I'll organize my undergraduate certificates later hhh)</span>
      </strong><br>
    </p>
  </div>

  {/* skills */}
  <h2 id='skills' class='mt-10'>Skills</h2>
  <div class='not-prose mt-4 flex flex-col gap-5'>
    {
      skills.map((cat) => (
        <div class='flex flex-col items-start'>
          <p class='mb-2 text-sm font-semibold text-muted-foreground'>{cat.title}</p>
          <img
            src={`https://skillicons.dev/icons?i=${cat.icons}&perline=15&theme=light`}
            alt={cat.title}
            class='block max-w-full'
            loading='lazy'
          />
        </div>
      ))
    }
  </div>
</PageLayout>

<style is:global>
  /* ==========================================================
     关于页中英文显示控制（全局样式，兼容 Timeline 内部 set:html 渲染的内容）
     ——默认英文（lang-zh 隐藏，lang-en 显示），首次进入即展示英文
     ——body[data-lang='zh'] 时反转全部显隐规则
     ========================================================== */
  /* 默认：中文隐藏 */
  .lang-zh,
  p .lang-zh,
  li .lang-zh,
  h1 .lang-zh,
  h2 .lang-zh,
  h3 .lang-zh,
  h4 .lang-zh,
  h5 .lang-zh,
  h6 .lang-zh,
  strong .lang-zh,
  blockquote .lang-zh,
  span .lang-zh,
  a .lang-zh {
    display: none !important;
  }
  /* 默认：英文显示（块级容器里的 span.lang-en → inline；<p>/<h> 里的 blockquote 里 → 正确的层级） */
  .lang-en,
  p .lang-en,
  li .lang-en,
  h1 .lang-en,
  h2 .lang-en,
  h3 .lang-en,
  h4 .lang-en,
  h5 .lang-en,
  h6 .lang-en,
  strong .lang-en,
  span .lang-en,
  a .lang-en {
    display: inline !important;
  }
  blockquote .lang-en {
    display: block !important;
  }

  /* body[data-lang='zh'] 时：中文显示，英文隐藏 */
  body[data-lang='zh'] .lang-zh,
  body[data-lang='zh'] p .lang-zh,
  body[data-lang='zh'] li .lang-zh,
  body[data-lang='zh'] h1 .lang-zh,
  body[data-lang='zh'] h2 .lang-zh,
  body[data-lang='zh'] h3 .lang-zh,
  body[data-lang='zh'] h4 .lang-zh,
  body[data-lang='zh'] h5 .lang-zh,
  body[data-lang='zh'] h6 .lang-zh,
  body[data-lang='zh'] strong .lang-zh,
  body[data-lang='zh'] span .lang-zh,
  body[data-lang='zh'] a .lang-zh {
    display: inline !important;
  }
  body[data-lang='zh'] blockquote .lang-zh {
    display: block !important;
  }
  body[data-lang='zh'] .lang-en,
  body[data-lang='zh'] p .lang-en,
  body[data-lang='zh'] li .lang-en,
  body[data-lang='zh'] h1 .lang-en,
  body[data-lang='zh'] h2 .lang-en,
  body[data-lang='zh'] h3 .lang-en,
  body[data-lang='zh'] h4 .lang-en,
  body[data-lang='zh'] h5 .lang-en,
  body[data-lang='zh'] h6 .lang-en,
  body[data-lang='zh'] strong .lang-en,
  body[data-lang='zh'] span .lang-en,
  body[data-lang='zh'] a .lang-en,
  body[data-lang='zh'] blockquote .lang-en {
    display: none !important;
  }
</style>

<script is:inline>
  /**
   * 关于页 中英文切换 ——提前在 DOMContentLoaded 之前就设置好 body[data-lang]，
   * 避免首屏先渲染中文再切换到英文产生的闪烁。
   * - 状态存 localStorage['about-lang'] = 'zh' | 'en'
   * - 默认：'en'（用户要求首次进入 About 默认显示英文）
   * - 之前保存了 zh 的用户可以按切换按钮回到中文
   */
  ;(function () {
    const KEY = 'about-lang'
    const DEFAULT_LANG = 'en' // About 默认英文

    // 第 0 步：在任何渲染发生前先同步到 <html>/<body>
    const saved = typeof localStorage !== 'undefined' ? localStorage.getItem(KEY) : null
    const lang = saved === 'zh' || saved === 'en' ? saved : DEFAULT_LANG

    function apply(l) {
      document.documentElement.setAttribute('data-lang', l)
      document.body && document.body.setAttribute('data-lang', l)
    }
    apply(lang)

    // 第 1 步：DOM ready 之后再绑定切换按钮（按钮此时已经挂到 DOM 上）
    function onReady() {
      apply(lang) // 再同步一次确保 body 有
      const btn = document.getElementById('about-lang-toggle')
      if (!btn) return
      btn.addEventListener('click', function () {
        const cur = (document.body.getAttribute('data-lang') === 'zh' ? 'zh' : 'en')
        const next = cur === 'en' ? 'zh' : 'en'
        apply(next)
        try { localStorage.setItem(KEY, next) } catch (e) {}
      })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onReady)
    } else {
      onReady()
    }
  })()
</script>
